# Application
PORT=3000
NODE_ENV=development
APP_NAME=Return Management System
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=return_management_db

# Session
SESSION_SECRET=your-very-secure-secret-key-change-this
SESSION_MAX_AGE=86400000

# Pagination
RECORDS_PER_PAGE=25

# Aging thresholds (days)
AGING_NORMAL=3
AGING_WARNING=7
AGING_CRITICAL=14

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/
