        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Ya, Hapus Permanen</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openHardDeleteSortingModal(itemId, skuName) {
    document.getElementById('hardDeleteSortingSkuText').textContent = skuName;
    document.getElementById('hardDeleteSortingForm').action = '/sorting/delete-item/' + itemId;
    const modal = new bootstrap.Modal(document.getElementById('hardDeleteSortingModal'));
    modal.show();
  }
</script>