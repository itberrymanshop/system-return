<style>
   .table-responsive {
     overflow-x: hidden !important;
   }
   .sorting-table-wrap {
     overflow-x: hidden;
   }
   .sorting-table-wrap .dataTables_wrapper {
     padding-top: .25rem;
   }
   .sorting-table-wrap .dataTables_filter {
     float: none;
     display: flex;
     justify-content: flex-end;
     margin-bottom: .75rem;
   }
   .sorting-table-wrap .dataTables_filter label {
     width: min(100%, 320px);
     margin: 0;
   }
   .sorting-table-wrap .dataTables_filter input {
     width: 100%;
     margin-left: 0;
     border: 1px solid #dee2e6;
     border-radius: .375rem;
     padding: .375rem .75rem;
   }
  .table-sticky-queue th:first-child,
  .table-sticky-queue td:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    background-color: #ffffff;
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    text-align: center;
    box-shadow: inset -1px 0 0 #dee2e6, 2px 0 6px rgba(0, 0, 0, 0.06);
  }
  .table-sticky-queue thead th:first-child {
    z-index: 3;
    background-color: #f8f9fa;
  }
  .table-sticky-queue tbody tr.table-danger td:first-child {
    background-color: #f8d7da;
  }
  .table-sticky-queue tbody tr:hover td:first-child {
    background-color: #f2f2f2;
  }
  .table-sticky-queue tbody tr.table-danger:hover td:first-child {
    background-color: #f1b0b7;
  }
   .table-sticky-queue {
     width: 100%;
     min-width: 0;
     table-layout: fixed;
   }
   .table-sticky-queue th,
   .table-sticky-queue td {
     white-space: normal;
     overflow-wrap: anywhere;
     word-break: break-word;
     vertical-align: middle;
   }
   .table-sticky-queue th:nth-child(1), .table-sticky-queue td:nth-child(1) { width: 42px; }
   .table-sticky-queue th:nth-child(2), .table-sticky-queue td:nth-child(2) { width: 42px; }
   .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { width: 82px; }
   .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { width: 88px; }
   .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { width: 18%; }
   .table-sticky-queue th:nth-child(6), .table-sticky-queue td:nth-child(6) { width: 52px; }
   .table-sticky-queue th:last-child, .table-sticky-queue td:last-child { width: 140px; }
   .table-sticky-queue thead th { background: #f8fafc; color: #475569; font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; border-bottom: 2px solid #e2e8f0; }
   .table-sticky-queue tbody td { padding-top: .8rem; padding-bottom: .8rem; }
   .table-sticky-queue tbody tr { transition: background-color .15s ease, box-shadow .15s ease; }
   .table-sticky-queue tbody tr:hover { background: #f8fafc; box-shadow: inset 3px 0 0 #0d6efd; }
   .table-sticky-queue thead th { position: relative; white-space: normal; word-break: normal; overflow-wrap: break-word; height: 56px; }
   .table-sticky-queue thead th .column-resizer { display: none; }
   .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { min-width: 125px; }
   .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { min-width: 110px; }
   .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { min-width: 240px; }
   .table-sticky-queue th:nth-child(7), .table-sticky-queue td:nth-child(7) { min-width: 120px; }
   .table-sticky-queue th:nth-child(8), .table-sticky-queue td:nth-child(8) { min-width: 150px; }
   .table-sticky-queue th:nth-child(9), .table-sticky-queue td:nth-child(9) { min-width: 140px; }
   .table-sticky-queue th:nth-child(10), .table-sticky-queue td:nth-child(10) { min-width: 105px; }
   .table-sticky-queue th:nth-child(11), .table-sticky-queue td:nth-child(11) { min-width: 130px; }
   .queue-sku { color: #0f172a; font-size: .82rem; }
   .queue-qty { display: inline-flex; min-width: 2.25rem; justify-content: center; padding: .15rem .45rem; border-radius: 999px; background: #e0f2fe; color: #075985; font-weight: 700; }
   @media (min-width: 1201px) {
     .table-sticky-queue { min-width: 100%; font-size: 1rem; }
     .table-sticky-queue th, .table-sticky-queue td { padding: .45rem .3rem; }
     .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { min-width: 88px; }
     .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { min-width: 72px; }
     .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { min-width: 150px; }
     .table-sticky-queue th:nth-child(7), .table-sticky-queue td:nth-child(7) { min-width: 78px; }
     .table-sticky-queue th:nth-child(8), .table-sticky-queue td:nth-child(8) { min-width: 100px; }
     .table-sticky-queue th:nth-child(9), .table-sticky-queue td:nth-child(9) { min-width: 95px; }
     .table-sticky-queue th:nth-child(10), .table-sticky-queue td:nth-child(10) { min-width: 78px; }
     .table-sticky-queue th:nth-child(11), .table-sticky-queue td:nth-child(11) { min-width: 95px; }
     .table-sticky-queue th:last-child, .table-sticky-queue td:last-child { min-width: 140px; }
   }
   @media (max-width: 767.98px) {
     .table-sticky-queue { font-size: .68rem; }
     .table-sticky-queue th, .table-sticky-queue td { padding: .35rem .2rem; }
     .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { width: 62px; }
     .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { width: 68px; }
     .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { width: 20%; }
     .single-process-btn { font-size: 0; padding: .35rem .4rem; }
     .single-process-btn i { font-size: .85rem; margin: 0 !important; }
   }
</style>

<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-upc-scan"></i> Antrian Sorting</h2>
      <p class="text-muted">Returns dalam status <strong>Inbound</strong> dan <strong>Sorting</strong> yang perlu
        diproses.</p>
    </div>
    <div class="col-auto">
      <a href="/returns/create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i> Input Retur Baru
      </a>
    </div>
  </div>

  <%# SLA Alerts %>
    <% if (slaAlerts.length> 0) { %>
      <div class="alert alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>
          <%= slaAlerts.length %> return
        </strong> mendekati atau melewati batas SLA.
      </div>
      <% } %>

        <form id="bulkSortForm" method="POST" action="/sorting/bulk">
          <!-- Bulk Action Card -->
          <div id="bulkActionCard" class="card mb-3 border-primary d-none">
            <div class="card-header bg-primary text-white">
              <h6 class="mb-0"><i class="bi bi-play-circle-fill"></i> Proses Sorting SKU Terpilih</h6>
            </div>
            <div class="card-body">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label fw-bold small">Status QC / Disposition <span
                      class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="bulkDisposition" name="disposition" required>
                    <option value="">-- Pilih Status QC --</option>
                    <option value="rekondisi">Rekondisi</option>
                    <option value="refurbish">Refurbish</option>
                    <option value="write_off">Write-Off</option>
                    <option value="return_to_supplier">Supplier Lokal</option>
                  </select>
                </div>
                <div class="col-md-3" id="bulkVendorCol" style="display: none;">
                  <label class="form-label fw-bold small">Supplier <span class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="bulkVendorId" name="vendor_id">
                    <option value="">-- Cari & Pilih Supplier --</option>
                    <% vendors.forEach(v=> { %>
                      <option value="<%= v.vendor_id %>">
                        <%= v.vendor_name %>
                      </option>
                      <% }) %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-bold small">Lokasi Fisik (Rak / Bin)</label>
                  <input type="text" class="form-control form-control-sm" name="physical_location"
                    placeholder="Contoh: RAK-A1">
                </div>
                <div class="col-md-3">
                  <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-check-circle"></i> Proses Sorting (<span id="selectedCount">0</span> SKU)
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h6 class="mb-0"><i class="bi bi-list-check"></i> Daftar Antrian</h6>
              <span class="badge bg-secondary">
                <%= items.length %> item
              </span>
            </div>
            <div class="table-responsive sorting-table-wrap">
              <table class="table table-hover table-sticky-queue mb-0" data-order='[[1, "asc"]]'>
                <thead class="table-light">
                  <tr>
                    <th style="width: 40px;"><input type="checkbox" id="selectAll"></th>
                    <th>#</th>
                    <th class="sorting-date">Tgl Masuk</th>
                    <th>SKU</th>
                    <th>Nama Barang</th>
                    <th>Qty</th>
                    <th class="sorting-optional">Kondisi</th>
                    <th class="sorting-optional">Kategori</th>
                    <th class="sorting-optional">Ikut WO</th>
                    <th>Status QC</th>
                    <th>SLA</th>
                    <th>Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach((item, i)=> { %>
                        <tr class="<%= item.slaAlert ? 'table-danger' : '' %>">
                          <td>
                            <input type="checkbox" name="item_ids[]" value="<%= item.item_id %>" class="item-checkbox">
                          </td>
                          <td>
                            <%= i + 1 %>
                          </td>
                           <td class="sorting-date">
                             <small>
                               <%= formatDate(item.return_date) %>
                            </small>
                            <% if (item.inbound_date) { %>
                              <br><small class="text-success"><i class="bi bi-check-circle"></i> Inbound: <%=
                                  formatDate(item.inbound_date) %></small>
                              <% } %>
                          </td>
<td><a href="/sorting/<%= item.return_id %>"
                               class="fw-bold text-decoration-none"><code class="queue-sku"><%= item.sku %></code></a></td>
                          <td><strong>
                              <%= item.item_name %>
                            </strong></td>
                           <td><span class="queue-qty"><%= item.quantity %></span></td>
                           <td class="text-capitalize sorting-optional">
                             <%= formatCategory(item.return_category) %>
                          </td>
                           <td class="sorting-optional">
                             <select class="form-select form-select-sm row-category-select"
                              name="category_<%= item.item_id %>" disabled style="display: none;">
                              <option value="">-- Pilih Kategori --</option>
                              <option value="Elektronik" <%=item.item_category==='Elektronik' ? 'selected' : '' %>
                                >Elektronik</option>
                              <option value="Non Elektronik" <%=item.item_category==='Non Elektronik' ? 'selected' : ''
                                %>>Non Elektronik</option>
                            </select>
                            <select class="form-select form-select-sm row-ikut-select" name="ikut_<%= item.item_id %>"
                              disabled style="display: none;">
                              <option value="">-- Pilih Kategori --</option>
                              <option value="Besi" <%=item.ikut==='Besi' ? 'selected' : '' %>>Besi</option>
                              <option value="Plastik" <%=item.ikut==='Plastik' ? 'selected' : '' %>>Plastik</option>
                              <option value="Kaca" <%=item.ikut==='Kaca' ? 'selected' : '' %>>Kaca</option>
                              <option value="Kain" <%=item.ikut==='Kain' ? 'selected' : '' %>>Kain</option>
                            </select>
                            <span class="text-muted row-placeholder-text">
                              <%= item.item_category || item.ikut || '-' %>
                            </span>
                          </td>
                          <td>
                            <select class="form-select form-select-sm row-ikut-wo-select" name="ikut_wo_<%= item.item_id %>"
                              disabled style="display: none;">
                              <option value="">-- Pilih Ikut WO --</option>
                              <option value="Ikut WO Rosok" <%=item.ikut_wo==='Ikut WO Rosok' ? 'selected' : '' %>>Ikut WO Rosok</option>
                              <option value="Ikut WO Tri J" <%=item.ikut_wo==='Ikut WO Tri J' ? 'selected' : '' %>>Ikut WO Tri J</option>
                            </select>
                            <span class="text-muted row-ikut-wo-placeholder">
                              <%= item.ikut_wo || '-' %>
                            </span>
                          </td>
                          <td>
                            <span
                              class="badge bg-<%= item.disposition === 'pending' ? 'warning' : 'success' %> text-capitalize">
                              <%= item.disposition %>
                            </span>
                          </td>
                          <td>
                            <% if (item.sla_deadline) { %>
                              <span class="badge bg-<%= item.slaInfo.color %> text-nowrap">
                                <i class="bi bi-clock"></i>
                                <%= item.slaInfo.label %>
                              </span>
                              <br><small class="text-muted">
                                <%= formatDate(item.sla_deadline) %>
                              </small>
                              <% } else { %><span class="text-muted">-</span>
                                <% } %>
                          </td>
                          <td class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap single-process-btn"
                              data-item-id="<%= item.item_id %>" title="Proses QC">
                              <i class="bi bi-arrow-right-circle"></i> Proses
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" 
                              onclick="openHardDeleteSortingModal('<%= item.item_id %>', '<%= item.sku %>')" title="Hapus Permanen">
                              <i class="bi bi-trash"></i>
                            </button>
                          </td>
                        </tr>
                        <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectAll = document.getElementById('selectAll');
    const bulkCard = document.getElementById('bulkActionCard');
    const selectedCountSpan = document.getElementById('selectedCount');
    const bulkDisposition = document.getElementById('bulkDisposition');
    const bulkSortForm = document.getElementById('bulkSortForm');
    const bulkVendorCol = document.getElementById('bulkVendorCol');
     const bulkVendorId = document.getElementById('bulkVendorId');
     const queueTable = document.querySelector('.table-sticky-queue');

     function setupColumnResize() {
       if (!queueTable) return;
       const headers = queueTable.querySelectorAll('thead th');
       const savedWidths = JSON.parse(localStorage.getItem(columnWidthKey) || '{}');
       headers.forEach((header, index) => {
         if (savedWidths[index]) header.style.width = `${savedWidths[index]}px`;
         const resizer = document.createElement('span');
         resizer.className = 'column-resizer';
         resizer.setAttribute('aria-label', 'Atur lebar kolom');
         header.appendChild(resizer);
         let startX;
         let startWidth;
         let resizing = false;

         const stopResize = () => {
           if (!resizing) return;
           resizing = false;
           resizer.classList.remove('active');
           document.body.style.cursor = '';
           document.body.style.userSelect = '';
           const widths = JSON.parse(localStorage.getItem(columnWidthKey) || '{}');
           widths[index] = header.getBoundingClientRect().width;
           localStorage.setItem(columnWidthKey, JSON.stringify(widths));
         };

         resizer.addEventListener('pointerdown', event => {
           event.preventDefault();
           event.stopPropagation();
           resizing = true;
           startX = event.clientX;
           startWidth = header.getBoundingClientRect().width;
           resizer.classList.add('active');
           document.body.style.cursor = 'col-resize';
           document.body.style.userSelect = 'none';
           resizer.setPointerCapture(event.pointerId);
         });
         resizer.addEventListener('pointermove', event => {
           if (!resizing) return;
           header.style.width = `${Math.max(42, startWidth + event.clientX - startX)}px`;
         });
         resizer.addEventListener('pointerup', stopResize);
         resizer.addEventListener('pointercancel', stopResize);
       });
     }

     if (window.$ && $.fn.DataTable) {
      $('.table-sticky-queue').each(function () {
        const $table = $(this);
        if ($.fn.DataTable.isDataTable(this)) {
          $table.DataTable().destroy();
        }
        $table.find('tbody tr td[colspan]').closest('tr').remove();
        $table.DataTable({
           paging: false,
           pageLength: -1,
           lengthChange: false,
           order: [[1, 'asc']],
          responsive: false,
          autoWidth: false,
          destroy: true,
          language: {
            search: '_INPUT_',
            searchPlaceholder: 'Cari antrian...',
            emptyTable: 'Antrian kosong'
          },
          columnDefs: [
            { orderable: false, targets: [0, -1] }
          ]
        });
      });
    }

    function initVendorSelect2() {
      if (window.$ && $.fn.select2) {
        $('#bulkVendorId').select2({
          theme: 'bootstrap-5',
          placeholder: '-- Cari & Pilih Supplier --',
          allowClear: true,
          width: '100%'
        });
      }
    }

    function updateBulkCard() {
      const checked = document.querySelectorAll('.item-checkbox:checked');
      if (checked.length > 0) {
        bulkCard.classList.remove('d-none');
        selectedCountSpan.textContent = checked.length;
      } else {
        bulkCard.classList.add('d-none');
      }
    }

    function updateRowCategories() {
      const bulkDisp = bulkDisposition ? bulkDisposition.value : '';
      const isCatReq = ['rekondisi', 'refurbish'].includes(bulkDisp);
      const isIkutReq = (bulkDisp === 'write_off');
      const activeCheckboxes = document.querySelectorAll('.item-checkbox');

      activeCheckboxes.forEach(cb => {
        const row = cb.closest('tr');
        const catSelect = row.querySelector('.row-category-select');
        const ikutSelect = row.querySelector('.row-ikut-select');
        const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
        const placeholder = row.querySelector('.row-placeholder-text');
        const ikutWoPlaceholder = row.querySelector('.row-ikut-wo-placeholder');

        if (cb.checked && isCatReq) {
          if (catSelect) {
            catSelect.style.display = '';
            catSelect.removeAttribute('disabled');
            catSelect.setAttribute('required', 'true');
          }
          if (ikutSelect) {
            ikutSelect.style.display = 'none';
            ikutSelect.setAttribute('disabled', 'true');
            ikutSelect.removeAttribute('required');
          }
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
            ikutWoSelect.value = '';
          }
          if (placeholder) placeholder.style.display = 'none';
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        } else if (cb.checked && isIkutReq) {
          if (catSelect) {
            catSelect.style.display = 'none';
            catSelect.setAttribute('disabled', 'true');
            catSelect.removeAttribute('required');
          }
          if (ikutSelect) {
            ikutSelect.style.display = '';
            ikutSelect.removeAttribute('disabled');
            ikutSelect.setAttribute('required', 'true');
          }
          if (placeholder) placeholder.style.display = 'none';

          if (ikutSelect && ikutSelect.value === 'Plastik') {
            if (ikutWoSelect) {
              ikutWoSelect.style.display = '';
              ikutWoSelect.removeAttribute('disabled');
              ikutWoSelect.setAttribute('required', 'true');
            }
            if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = 'none';
          } else {
            if (ikutWoSelect) {
              ikutWoSelect.style.display = 'none';
              ikutWoSelect.setAttribute('disabled', 'true');
              ikutWoSelect.removeAttribute('required');
              ikutWoSelect.value = '';
            }
            if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
          }
        } else {
          if (catSelect) {
            catSelect.style.display = 'none';
            catSelect.setAttribute('disabled', 'true');
            catSelect.removeAttribute('required');
          }
          if (ikutSelect) {
            ikutSelect.style.display = 'none';
            ikutSelect.setAttribute('disabled', 'true');
            ikutSelect.removeAttribute('required');
          }
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
          }
          if (placeholder) placeholder.style.display = '';
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        }
      });
    }

    if (bulkDisposition) {
      bulkDisposition.addEventListener('change', function () {
        updateRowCategories();

        if (this.value === 'return_to_supplier') {
          if (bulkVendorCol) bulkVendorCol.style.display = '';
          initVendorSelect2();
        } else {
          if (bulkVendorCol) bulkVendorCol.style.display = 'none';
          if (window.$ && $.fn.select2) {
            $('#bulkVendorId').val(null).trigger('change');
          } else if (bulkVendorId) {
            bulkVendorId.value = '';
          }
        }
      });
    }

    if (bulkSortForm) {
      bulkSortForm.addEventListener('submit', function (e) {
        if (bulkDisposition && bulkDisposition.value === 'return_to_supplier') {
          const vVal = bulkVendorId ? bulkVendorId.value : '';
          if (!vVal) {
            e.preventDefault();
            alert('Silakan cari dan pilih Supplier terlebih dahulu.');
            if (window.$ && $.fn.select2) {
              $('#bulkVendorId').select2('open');
            }
            return false;
          }
        }

        if (bulkDisposition && bulkDisposition.value === 'write_off') {
          const activeCheckboxes = document.querySelectorAll('.item-checkbox:checked');
          for (const cb of activeCheckboxes) {
            const row = cb.closest('tr');
            const ikutSelect = row.querySelector('.row-ikut-select');
            const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
            if (ikutSelect && ikutSelect.value === 'Plastik' && (!ikutWoSelect || !ikutWoSelect.value)) {
              e.preventDefault();
              alert('Silakan pilih opsi Ikut WO (Ikut WO Rosok / Ikut WO Tri J) untuk SKU berkategori Plastik.');
              if (ikutWoSelect) {
                ikutWoSelect.focus();
              }
              return false;
            }
          }
        }
      });
    }

    if (selectAll) {
      selectAll.addEventListener('change', function () {
        const activeCheckboxes = document.querySelectorAll('.item-checkbox');
        activeCheckboxes.forEach(cb => {
          cb.checked = this.checked;
        });
        updateBulkCard();
        updateRowCategories();
      });
    }

    // Event delegation for checkbox changes
    document.addEventListener('change', function (e) {
      if (e.target.classList.contains('item-checkbox')) {
        if (!e.target.checked && selectAll) {
          selectAll.checked = false;
        }
        updateBulkCard();
        updateRowCategories();
      }

      if (e.target.classList.contains('row-ikut-select')) {
        const row = e.target.closest('tr');
        const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
        const ikutWoPlaceholder = row.querySelector('.row-ikut-wo-placeholder');
        if (e.target.value === 'Plastik') {
          if (ikutWoSelect) {
            ikutWoSelect.style.display = '';
            ikutWoSelect.removeAttribute('disabled');
            ikutWoSelect.setAttribute('required', 'true');
          }
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = 'none';
        } else {
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
            ikutWoSelect.value = '';
          }
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        }
      }
    });

    // Event delegation for single "Proses" button click
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.single-process-btn');
      if (btn) {
        e.preventDefault();
        const itemId = btn.dataset.itemId;
        const activeCheckboxes = document.querySelectorAll('.item-checkbox');
        activeCheckboxes.forEach(cb => {
          cb.checked = (cb.value === itemId);
        });
        updateBulkCard();
        updateRowCategories();
        if (bulkCard) {
          bulkCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  });
</script>

