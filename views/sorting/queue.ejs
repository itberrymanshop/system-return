<style>
   .table-responsive {
     overflow-x: hidden !important;
   }
   .table-sticky-queue { border-collapse: separate; border-spacing: 0 .75rem; }
   .table-sticky-queue thead { display: none; }
   .table-sticky-queue tbody tr { display: grid; grid-template-columns: 42px 1fr 1fr 1fr 90px; gap: .35rem 1rem; padding: 1.1rem; background: #fff; border: 1px solid #e5e7eb; border-top: 4px solid #6c757d; border-radius: 14px; box-shadow: 0 4px 14px rgba(15,23,42,.06); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
   .table-sticky-queue tbody tr:hover { transform: translateY(-2px); border-color: #0d6efd; box-shadow: 0 10px 24px rgba(15,23,42,.13); }
   .table-sticky-queue tbody tr.table-danger { border-top-color: #dc3545; }
   .sorting-card { background: #fff; border: 1px solid #e5e7eb; border-top: 4px solid #6c757d; border-radius: 14px; box-shadow: 0 4px 14px rgba(15,23,42,.06); overflow: hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
   .sorting-card:hover { transform: translateY(-3px); border-color: #0d6efd; box-shadow: 0 10px 24px rgba(15,23,42,.13); }
   .sorting-card-danger { border-top-color: #dc3545; }
   .sorting-card-header, .sorting-card-footer { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: 1rem 1.1rem; background: #f8fafc; }
   .sorting-card-header { border-bottom: 1px solid #edf0f2; }
   .sorting-card-footer { border-top: 1px solid #edf0f2; justify-content: flex-end; }
   .sorting-card-body { padding: 1rem 1.1rem; }
   .sorting-select-label { display: inline-flex; align-items: center; gap: .45rem; font-size: .8rem; font-weight: 600; cursor: pointer; }
   .sorting-select-label .form-check-input { width: 1.1rem; height: 1.1rem; margin: 0; }
   .sorting-label { display: block; color: #6b7280; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .2rem; }
   .sorting-meta-grid, .sorting-packaging { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
   .sorting-packaging { padding: .65rem .75rem; background: #f1f5f9; border-radius: 9px; }
   .sorting-card .row-category-select, .sorting-card .row-ikut-select, .sorting-card .row-ikut-wo-select { width: 100%; }
   .sorting-card .queue-sku { font-size: .9rem; }
   .sorting-card .queue-qty { display: inline-flex; min-width: 2.25rem; justify-content: center; padding: .15rem .45rem; border-radius: 999px; background: #e0f2fe; color: #075985; font-weight: 700; }
   .table-sticky-queue tbody td { display: flex; align-items: center; min-width: 0; padding: .25rem; border: 0; }
   .table-sticky-queue tbody td::before { display: block; color: #64748b; font-size: .68rem; font-weight: 700; text-transform: uppercase; margin-right: .5rem; min-width: 4.5rem; }
   .table-sticky-queue tbody td:first-child::before, .table-sticky-queue tbody td:nth-child(2)::before { display: none; }
   .table-sticky-queue tbody td:nth-child(3)::before { content: 'Tgl Masuk'; }
   .table-sticky-queue tbody td:nth-child(4)::before { content: 'SKU'; }
   .table-sticky-queue tbody td:nth-child(5)::before { content: 'Barang'; }
   .table-sticky-queue tbody td:nth-child(6)::before { content: 'Qty'; }
   .table-sticky-queue tbody td:nth-child(7)::before { content: 'Kondisi'; }
   .table-sticky-queue tbody td:nth-child(8)::before { content: 'Kategori'; }
   .table-sticky-queue tbody td:nth-child(9)::before { content: 'Ikut WO'; }
   .table-sticky-queue tbody td:nth-child(10)::before { content: 'Status QC'; }
   .table-sticky-queue tbody td:nth-child(11)::before { content: 'SLA'; }
   .table-sticky-queue tbody td:nth-child(12)::before { content: 'Aksi'; }
   .table-sticky-queue tbody td:nth-child(1) { grid-column: 1; grid-row: 1 / span 2; }
   .table-sticky-queue tbody td:nth-child(2) { grid-column: 5; grid-row: 1; justify-content: flex-end; }
   .table-sticky-queue tbody td:nth-child(3) { grid-column: 2 / span 2; grid-row: 1; }
   .table-sticky-queue tbody td:nth-child(4) { grid-column: 2; grid-row: 2; }
   .table-sticky-queue tbody td:nth-child(5) { grid-column: 3 / span 2; grid-row: 2; }
   .table-sticky-queue tbody td:nth-child(6) { grid-column: 5; grid-row: 2; }
   .table-sticky-queue tbody td:nth-child(7) { grid-column: 1 / span 2; grid-row: 3; }
   .table-sticky-queue tbody td:nth-child(8) { grid-column: 3 / span 2; grid-row: 3; }
   .table-sticky-queue tbody td:nth-child(9) { grid-column: 5; grid-row: 3; }
   .table-sticky-queue tbody td:nth-child(10) { grid-column: 1 / span 2; grid-row: 4; }
   .table-sticky-queue tbody td:nth-child(11) { grid-column: 3 / span 2; grid-row: 4; }
   .table-sticky-queue tbody td:nth-child(12) { grid-column: 5; grid-row: 4; justify-content: flex-end; }
   .table-sticky-queue tbody td:first-child { position: static; width: auto; min-width: 0; max-width: none; box-shadow: none; background: transparent; }
   .table-sticky-queue tbody tr:hover { box-shadow: 0 5px 16px rgba(15,23,42,.1); }
   .table-sticky-queue tbody td select { min-width: 0; }
   @media (max-width: 600px) {
      .table-sticky-queue tbody tr, .sorting-card { grid-template-columns: 34px 1fr 1fr; gap: .3rem .5rem; padding: .75rem; }
     .table-sticky-queue tbody td:nth-child(1) { grid-column: 1; grid-row: 1; }
     .table-sticky-queue tbody td:nth-child(2) { grid-column: 3; grid-row: 1; }
     .table-sticky-queue tbody td:nth-child(3), .table-sticky-queue tbody td:nth-child(4), .table-sticky-queue tbody td:nth-child(5), .table-sticky-queue tbody td:nth-child(7), .table-sticky-queue tbody td:nth-child(8), .table-sticky-queue tbody td:nth-child(9), .table-sticky-queue tbody td:nth-child(10), .table-sticky-queue tbody td:nth-child(11) { grid-column: 1 / span 3; }
     .table-sticky-queue tbody td:nth-child(6) { grid-column: 3; grid-row: 2; }
     .table-sticky-queue tbody td:nth-child(12) { grid-column: 1 / span 3; justify-content: stretch; }
     .table-sticky-queue tbody td:nth-child(12) button { width: 100%; }
   }
  .table-sticky-queue th:first-child,
  .table-sticky-queue td:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    background-color: #ffffff;
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    text-align: center;
    box-shadow: inset -1px 0 0 #dee2e6, 2px 0 6px rgba(0, 0, 0, 0.06);
  }
  .table-sticky-queue thead th:first-child {
    z-index: 3;
    background-color: #f8f9fa;
  }
  .table-sticky-queue tbody tr.table-danger td:first-child {
    background-color: #f8d7da;
  }
  .table-sticky-queue tbody tr:hover td:first-child {
    background-color: #f2f2f2;
  }
  .table-sticky-queue tbody tr.table-danger:hover td:first-child {
    background-color: #f1b0b7;
  }
   .table-sticky-queue {
     width: 100%;
     table-layout: fixed;
   }
   .table-sticky-queue th,
   .table-sticky-queue td {
     white-space: normal;
     overflow-wrap: anywhere;
     word-break: break-word;
     vertical-align: middle;
   }
   .table-sticky-queue th:nth-child(1), .table-sticky-queue td:nth-child(1) { width: 42px; }
   .table-sticky-queue th:nth-child(2), .table-sticky-queue td:nth-child(2) { width: 42px; }
   .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { width: 82px; }
   .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { width: 88px; }
   .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { width: 18%; }
   .table-sticky-queue th:nth-child(6), .table-sticky-queue td:nth-child(6) { width: 52px; }
   .table-sticky-queue th:last-child, .table-sticky-queue td:last-child { width: 76px; }
   .table-sticky-queue thead th { background: #f8fafc; color: #475569; font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; border-bottom: 2px solid #e2e8f0; }
   .table-sticky-queue tbody td { padding-top: .8rem; padding-bottom: .8rem; }
   .table-sticky-queue tbody tr { transition: background-color .15s ease, box-shadow .15s ease; }
   .table-sticky-queue tbody tr:hover { background: #f8fafc; box-shadow: inset 3px 0 0 #0d6efd; }
   .queue-sku { color: #0f172a; font-size: .82rem; }
   .queue-qty { display: inline-flex; min-width: 2.25rem; justify-content: center; padding: .15rem .45rem; border-radius: 999px; background: #e0f2fe; color: #075985; font-weight: 700; }
   @media (max-width: 767.98px) {
     .table-sticky-queue { font-size: .68rem; }
     .table-sticky-queue th, .table-sticky-queue td { padding: .35rem .2rem; }
     .table-sticky-queue th:nth-child(3), .table-sticky-queue td:nth-child(3) { width: 62px; }
     .table-sticky-queue th:nth-child(4), .table-sticky-queue td:nth-child(4) { width: 68px; }
     .table-sticky-queue th:nth-child(5), .table-sticky-queue td:nth-child(5) { width: 20%; }
     .single-process-btn { font-size: 0; padding: .35rem .4rem; }
     .single-process-btn i { font-size: .85rem; margin: 0 !important; }
   }
</style>

<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-upc-scan"></i> Antrian Sorting</h2>
      <p class="text-muted">Returns dalam status <strong>Inbound</strong> dan <strong>Sorting</strong> yang perlu
        diproses.</p>
    </div>
    <div class="col-auto">
      <a href="/returns/create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i> Input Retur Baru
      </a>
    </div>
  </div>

  <%# SLA Alerts %>
    <% if (slaAlerts.length> 0) { %>
      <div class="alert alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>
          <%= slaAlerts.length %> return
        </strong> mendekati atau melewati batas SLA.
      </div>
      <% } %>

        <form id="bulkSortForm" method="POST" action="/sorting/bulk">
          <!-- Bulk Action Card -->
          <div id="bulkActionCard" class="card mb-3 border-primary d-none">
            <div class="card-header bg-primary text-white">
              <h6 class="mb-0"><i class="bi bi-play-circle-fill"></i> Proses Sorting SKU Terpilih</h6>
            </div>
            <div class="card-body">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label fw-bold small">Status QC / Disposition <span
                      class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="bulkDisposition" name="disposition" required>
                    <option value="">-- Pilih Status QC --</option>
                    <option value="rekondisi">Rekondisi</option>
                    <option value="refurbish">Refurbish</option>
                    <option value="write_off">Write-Off</option>
                    <option value="return_to_supplier">Supplier Lokal</option>
                  </select>
                </div>
                <div class="col-md-3" id="bulkVendorCol" style="display: none;">
                  <label class="form-label fw-bold small">Supplier <span class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="bulkVendorId" name="vendor_id">
                    <option value="">-- Cari & Pilih Supplier --</option>
                    <% vendors.forEach(v=> { %>
                      <option value="<%= v.vendor_id %>">
                        <%= v.vendor_name %>
                      </option>
                      <% }) %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-bold small">Lokasi Fisik (Rak / Bin)</label>
                  <input type="text" class="form-control form-control-sm" name="physical_location"
                    placeholder="Contoh: RAK-A1">
                </div>
                <div class="col-md-3">
                  <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-check-circle"></i> Proses Sorting (<span id="selectedCount">0</span> SKU)
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h6 class="mb-0"><i class="bi bi-list-check"></i> Daftar Antrian</h6>
              <span class="badge bg-secondary">
                <%= items.length %> item
              </span>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="btn btn-sm btn-outline-primary mb-0">
                  <input type="checkbox" id="selectAll" class="form-check-input me-1">
                  Pilih Semua
                </label>
              </div>
              <div class="row g-3 sorting-card-grid">
                <% if (items.length === 0) { %>
                  <div class="col-12"><div class="alert alert-light text-center mb-0">Antrian kosong.</div></div>
                <% } %>
                <% items.forEach((item, i)=> { %>
                  <div class="col-12 col-lg-6 col-xxl-4">
                    <article class="sorting-card h-100 <%= item.slaAlert ? 'sorting-card-danger' : '' %>">
                      <div class="sorting-card-header">
                        <label class="sorting-select-label">
                          <input type="checkbox" name="item_ids[]" value="<%= item.item_id %>" class="form-check-input item-checkbox">
                          <span>#<%= i + 1 %></span>
                        </label>
                        <div class="text-end">
                          <span class="badge bg-<%= item.disposition === 'pending' ? 'warning' : 'success' %> text-capitalize"><%= item.disposition %></span>
                          <% if (item.sla_deadline) { %>
                            <span class="badge bg-<%= item.slaInfo.color %> text-nowrap ms-1"><i class="bi bi-clock"></i> <%= item.slaInfo.label %></span>
                          <% } %>
                        </div>
                      </div>
                      <div class="sorting-card-body">
                        <div class="d-flex justify-content-between gap-3 mb-3">
                          <div class="min-w-0">
                            <span class="sorting-label">SKU</span>
                            <a href="/sorting/<%= item.return_id %>" class="fw-bold text-decoration-none"><code class="queue-sku"><%= item.sku %></code></a>
                          </div>
                          <div class="text-end">
                            <span class="sorting-label">Qty</span>
                            <span class="queue-qty"><%= item.quantity %></span>
                          </div>
                        </div>
                        <div class="mb-3"><span class="sorting-label">Nama Barang</span><strong><%= item.item_name %></strong></div>
                        <div class="sorting-meta-grid">
                          <div><span class="sorting-label">Tgl Masuk</span><small><%= formatDate(item.return_date) %></small><% if (item.inbound_date) { %><br><small class="text-success"><i class="bi bi-check-circle"></i> Inbound: <%= formatDate(item.inbound_date) %></small><% } %></div>
                          <div><span class="sorting-label">Kondisi</span><span class="text-capitalize"><%= formatCategory(item.return_category) %></span></div>
                        </div>
                        <div class="sorting-packaging mt-3">
                          <div>
                            <span class="sorting-label">Kategori</span>
                            <select class="form-select form-select-sm row-category-select" name="category_<%= item.item_id %>" disabled style="display: none;">
                              <option value="">-- Pilih Kategori --</option>
                              <option value="Elektronik" <%=item.item_category==='Elektronik' ? 'selected' : '' %>>Elektronik</option>
                              <option value="Non Elektronik" <%=item.item_category==='Non Elektronik' ? 'selected' : '' %>>Non Elektronik</option>
                            </select>
                            <select class="form-select form-select-sm row-ikut-select" name="ikut_<%= item.item_id %>" disabled style="display: none;">
                              <option value="">-- Pilih Kategori --</option>
                              <option value="Besi" <%=item.ikut==='Besi' ? 'selected' : '' %>>Besi</option>
                              <option value="Plastik" <%=item.ikut==='Plastik' ? 'selected' : '' %>>Plastik</option>
                              <option value="Kaca" <%=item.ikut==='Kaca' ? 'selected' : '' %>>Kaca</option>
                              <option value="Kain" <%=item.ikut==='Kain' ? 'selected' : '' %>>Kain</option>
                            </select>
                            <span class="text-muted row-placeholder-text"><%= item.item_category || item.ikut || '-' %></span>
                          </div>
                          <div>
                            <span class="sorting-label">Ikut WO</span>
                            <select class="form-select form-select-sm row-ikut-wo-select" name="ikut_wo_<%= item.item_id %>" disabled style="display: none;">
                              <option value="">-- Pilih Ikut WO --</option>
                              <option value="Ikut WO Rosok" <%=item.ikut_wo==='Ikut WO Rosok' ? 'selected' : '' %>>Ikut WO Rosok</option>
                              <option value="Ikut WO Tri J" <%=item.ikut_wo==='Ikut WO Tri J' ? 'selected' : '' %>>Ikut WO Tri J</option>
                            </select>
                            <span class="text-muted row-ikut-wo-placeholder"><%= item.ikut_wo || '-' %></span>
                          </div>
                        </div>
                        <% if (item.sla_deadline) { %>
                          <div class="text-muted small mt-3"><i class="bi bi-clock-history me-1"></i>Deadline SLA: <%= formatDate(item.sla_deadline) %></div>
                        <% } %>
                      </div>
                      <div class="sorting-card-footer">
                        <button type="button" class="btn btn-sm btn-outline-primary text-nowrap single-process-btn" data-item-id="<%= item.item_id %>">
                          <i class="bi bi-arrow-right-circle"></i> Proses
                        </button>
                      </div>
                    </article>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectAll = document.getElementById('selectAll');
    const bulkCard = document.getElementById('bulkActionCard');
    const selectedCountSpan = document.getElementById('selectedCount');
    const bulkDisposition = document.getElementById('bulkDisposition');
    const bulkSortForm = document.getElementById('bulkSortForm');
    const bulkVendorCol = document.getElementById('bulkVendorCol');
    const bulkVendorId = document.getElementById('bulkVendorId');

    document.querySelectorAll('.table-sticky-queue tbody tr td[colspan]').forEach(cell => cell.closest('.sorting-card').remove());

    function initVendorSelect2() {
      if (window.$ && $.fn.select2) {
        $('#bulkVendorId').select2({
          theme: 'bootstrap-5',
          placeholder: '-- Cari & Pilih Supplier --',
          allowClear: true,
          width: '100%'
        });
      }
    }

    function updateBulkCard() {
      const checked = document.querySelectorAll('.item-checkbox:checked');
      if (checked.length > 0) {
        bulkCard.classList.remove('d-none');
        selectedCountSpan.textContent = checked.length;
      } else {
        bulkCard.classList.add('d-none');
      }
    }

    function updateRowCategories() {
      const bulkDisp = bulkDisposition ? bulkDisposition.value : '';
      const isCatReq = ['rekondisi', 'refurbish'].includes(bulkDisp);
      const isIkutReq = (bulkDisp === 'write_off');
      const activeCheckboxes = document.querySelectorAll('.item-checkbox');

      activeCheckboxes.forEach(cb => {
        const row = cb.closest('.sorting-card');
        const catSelect = row.querySelector('.row-category-select');
        const ikutSelect = row.querySelector('.row-ikut-select');
        const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
        const placeholder = row.querySelector('.row-placeholder-text');
        const ikutWoPlaceholder = row.querySelector('.row-ikut-wo-placeholder');

        if (cb.checked && isCatReq) {
          if (catSelect) {
            catSelect.style.display = '';
            catSelect.removeAttribute('disabled');
            catSelect.setAttribute('required', 'true');
          }
          if (ikutSelect) {
            ikutSelect.style.display = 'none';
            ikutSelect.setAttribute('disabled', 'true');
            ikutSelect.removeAttribute('required');
          }
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
            ikutWoSelect.value = '';
          }
          if (placeholder) placeholder.style.display = 'none';
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        } else if (cb.checked && isIkutReq) {
          if (catSelect) {
            catSelect.style.display = 'none';
            catSelect.setAttribute('disabled', 'true');
            catSelect.removeAttribute('required');
          }
          if (ikutSelect) {
            ikutSelect.style.display = '';
            ikutSelect.removeAttribute('disabled');
            ikutSelect.setAttribute('required', 'true');
          }
          if (placeholder) placeholder.style.display = 'none';

          if (ikutSelect && ikutSelect.value === 'Plastik') {
            if (ikutWoSelect) {
              ikutWoSelect.style.display = '';
              ikutWoSelect.removeAttribute('disabled');
              ikutWoSelect.setAttribute('required', 'true');
            }
            if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = 'none';
          } else {
            if (ikutWoSelect) {
              ikutWoSelect.style.display = 'none';
              ikutWoSelect.setAttribute('disabled', 'true');
              ikutWoSelect.removeAttribute('required');
              ikutWoSelect.value = '';
            }
            if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
          }
        } else {
          if (catSelect) {
            catSelect.style.display = 'none';
            catSelect.setAttribute('disabled', 'true');
            catSelect.removeAttribute('required');
          }
          if (ikutSelect) {
            ikutSelect.style.display = 'none';
            ikutSelect.setAttribute('disabled', 'true');
            ikutSelect.removeAttribute('required');
          }
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
          }
          if (placeholder) placeholder.style.display = '';
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        }
      });
    }

    if (bulkDisposition) {
      bulkDisposition.addEventListener('change', function () {
        updateRowCategories();

        if (this.value === 'return_to_supplier') {
          if (bulkVendorCol) bulkVendorCol.style.display = '';
          initVendorSelect2();
        } else {
          if (bulkVendorCol) bulkVendorCol.style.display = 'none';
          if (window.$ && $.fn.select2) {
            $('#bulkVendorId').val(null).trigger('change');
          } else if (bulkVendorId) {
            bulkVendorId.value = '';
          }
        }
      });
    }

    if (bulkSortForm) {
      bulkSortForm.addEventListener('submit', function (e) {
        if (bulkDisposition && bulkDisposition.value === 'return_to_supplier') {
          const vVal = bulkVendorId ? bulkVendorId.value : '';
          if (!vVal) {
            e.preventDefault();
            alert('Silakan cari dan pilih Supplier terlebih dahulu.');
            if (window.$ && $.fn.select2) {
              $('#bulkVendorId').select2('open');
            }
            return false;
          }
        }

        if (bulkDisposition && bulkDisposition.value === 'write_off') {
          const activeCheckboxes = document.querySelectorAll('.item-checkbox:checked');
          for (const cb of activeCheckboxes) {
            const row = cb.closest('.sorting-card');
            const ikutSelect = row.querySelector('.row-ikut-select');
            const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
            if (ikutSelect && ikutSelect.value === 'Plastik' && (!ikutWoSelect || !ikutWoSelect.value)) {
              e.preventDefault();
              alert('Silakan pilih opsi Ikut WO (Ikut WO Rosok / Ikut WO Tri J) untuk SKU berkategori Plastik.');
              if (ikutWoSelect) {
                ikutWoSelect.focus();
              }
              return false;
            }
          }
        }
      });
    }

    if (selectAll) {
      selectAll.addEventListener('change', function () {
        const activeCheckboxes = document.querySelectorAll('.item-checkbox');
        activeCheckboxes.forEach(cb => {
          cb.checked = this.checked;
        });
        updateBulkCard();
        updateRowCategories();
      });
    }

    // Event delegation for checkbox changes
    document.addEventListener('change', function (e) {
      if (e.target.classList.contains('item-checkbox')) {
        if (!e.target.checked && selectAll) {
          selectAll.checked = false;
        }
        updateBulkCard();
        updateRowCategories();
      }

      if (e.target.classList.contains('row-ikut-select')) {
        const row = e.target.closest('.sorting-card');
        const ikutWoSelect = row.querySelector('.row-ikut-wo-select');
        const ikutWoPlaceholder = row.querySelector('.row-ikut-wo-placeholder');
        if (e.target.value === 'Plastik') {
          if (ikutWoSelect) {
            ikutWoSelect.style.display = '';
            ikutWoSelect.removeAttribute('disabled');
            ikutWoSelect.setAttribute('required', 'true');
          }
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = 'none';
        } else {
          if (ikutWoSelect) {
            ikutWoSelect.style.display = 'none';
            ikutWoSelect.setAttribute('disabled', 'true');
            ikutWoSelect.removeAttribute('required');
            ikutWoSelect.value = '';
          }
          if (ikutWoPlaceholder) ikutWoPlaceholder.style.display = '';
        }
      }
    });

    // Event delegation for single "Proses" button click
    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.single-process-btn');
      if (btn) {
        e.preventDefault();
        const itemId = btn.dataset.itemId;
        const activeCheckboxes = document.querySelectorAll('.item-checkbox');
        activeCheckboxes.forEach(cb => {
          cb.checked = (cb.value === itemId);
        });
        updateBulkCard();
        updateRowCategories();
        if (bulkCard) {
          bulkCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  });
</script>