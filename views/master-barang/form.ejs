<div class="container mt-5 pt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
          <i class="bi bi-box-seam-fill text-primary"></i>
          <%= item ? 'Edit Barang' : 'Tambah Barang Baru' %>
        </h2>
        <a href="/master-barang" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Kembali
        </a>
      </div>

      <div class="card">
        <div class="card-header">
          <h6 class="mb-0">Informasi Barang</h6>
        </div>
        <div class="card-body">
          <form action="<%= action %>" method="POST">

            <div class="row g-3">

              <%# Kode Barang %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Kode Barang <span class="text-danger">*</span></label>
                <input type="text" name="kode_barang" class="form-control"
                       value="<%= item ? item.kode_barang : '' %>"
                       placeholder="Contoh: KB-001"
                       required maxlength="100"
                       <%= item ? '' : '' %>>
                <div class="form-text">Kode unik (SKU) untuk identifikasi barang.</div>
              </div>

              <%# Nama Barang %>
              <div class="col-md-8">
                <label class="form-label fw-semibold">Nama Barang <span class="text-danger">*</span></label>
                <input type="text" name="nama_barang" class="form-control"
                       value="<%= item ? item.nama_barang : '' %>"
                       placeholder="Nama lengkap barang"
                       required maxlength="255">
              </div>

              <%# Kategori %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Kategori</label>
                <input type="text" name="kategori" class="form-control"
                       value="<%= item ? (item.kategori || '') : '' %>"
                       placeholder="Contoh: Elektronik"
                       maxlength="100" list="kategori-list">
                <datalist id="kategori-list">
                  <option value="Elektronik">
                  <option value="Aksesoris">
                  <option value="Spare Part">
                  <option value="Komputer">
                  <option value="Handphone">
                  <option value="Furniture">
                  <option value="Lainnya">
                </datalist>
              </div>

              <%# Satuan %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Satuan</label>
                <input type="text" name="satuan" class="form-control"
                       value="<%= item ? (item.satuan || '') : '' %>"
                       placeholder="pcs / unit / kg"
                       maxlength="50" list="satuan-list">
                <datalist id="satuan-list">
                  <option value="pcs">
                  <option value="unit">
                  <option value="kg">
                  <option value="set">
                  <option value="lusin">
                </datalist>
              </div>

              <%# Stok Minimum %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Stok Minimum</label>
                <input type="number" name="stok_minimum" class="form-control"
                       value="<%= item ? (item.stok_minimum || 0) : 0 %>"
                       min="0" placeholder="0">
                <div class="form-text">Batas minimum stok untuk peringatan.</div>
              </div>

              <%# Harga Beli %>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Harga Beli (Rp)</label>
                <div class="input-group">
                  <span class="input-group-text">Rp</span>
                  <input type="number" name="harga_beli" class="form-control"
                         value="<%= item ? (item.harga_beli || 0) : 0 %>"
                         min="0" step="100" placeholder="0">
                </div>
              </div>

              <%# Harga Jual %>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Harga Jual (Rp)</label>
                <div class="input-group">
                  <span class="input-group-text">Rp</span>
                  <input type="number" name="harga_jual" class="form-control"
                         value="<%= item ? (item.harga_jual || 0) : 0 %>"
                         min="0" step="100" placeholder="0">
                </div>
              </div>

              <%# Status (hanya tampil saat edit) %>
              <% if (item) { %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Status</label>
                <select name="status" class="form-select">
                  <option value="active"   <%= item.status === 'active'   ? 'selected' : '' %>>Aktif</option>
                  <option value="inactive" <%= item.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <% } %>

              <%# Deskripsi %>
              <div class="col-12">
                <label class="form-label fw-semibold">Deskripsi</label>
                <textarea name="deskripsi" class="form-control" rows="3"
                          placeholder="Keterangan tambahan tentang barang ini..."><%= item ? (item.deskripsi || '') : '' %></textarea>
              </div>

            </div>

            <hr>

            <div class="d-flex justify-content-end gap-2">
              <a href="/master-barang" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Batal
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> <%= item ? 'Simpan Perubahan' : 'Tambah Barang' %>
              </button>
            </div>

          </form>
        </div>
      </div>

    </div>
  </div>
</div>
