<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - <%= appName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-container {
      background: white;
      padding: 40px;
      border-radius: 15px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      max-width: 450px;
      width: 100%;
    }
    .login-icon { font-size: 60px; color: #667eea; }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="text-center mb-4">
      <i class="bi bi-arrow-return-left login-icon"></i>
      <h3 class="mt-2 fw-bold"><%= appName %></h3>
      <p class="text-muted">Return Management System</p>
    </div>

    <% if (error && error.length) { %>
      <% error.forEach(msg => { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle"></i> <%= msg %></div>
      <% }) %>
    <% } %>

    <form method="POST" action="/auth/login">
      <div class="mb-3">
        <label class="form-label fw-semibold">Username</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-person"></i></span>
          <input type="text" class="form-control" name="username" required autofocus placeholder="Enter username">
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold">Password</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-lock"></i></span>
          <input type="password" class="form-control" name="password" required placeholder="Enter password">
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="bi bi-box-arrow-in-right"></i> Sign In
      </button>
    </form>

    <p class="text-center text-muted mt-3 mb-0" style="font-size:.85rem;">
      &copy; <%= new Date().getFullYear() %> <%= appName %>
    </p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
