<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-clock-history"></i> Aging Report</h2>
    </div>
    <div class="col-auto">
      <form class="d-flex gap-2 align-items-end" method="GET" action="/reports/aging">

        <div>
          <label class="form-label mb-1 small">Category</label>
          <select class="form-select form-select-sm" name="category">
            <option value="">All</option>
            <% 
              const categories = [
                ['baik', 'Baik'],
                ['kurang_part', 'Kurang Part'],
                ['packaging_rusak', 'Packaging Rusak'],
                ['pecah', 'Pecah']
              ];
              categories.forEach(([v, l]) => { 
            %>
              <option value="<%= v %>" <%= filters.category === v ? 'selected' : '' %>><%= l %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-primary btn-sm">Filter</button>
        <a href="/reports/aging" class="btn btn-outline-secondary btn-sm">Reset</a>
      </form>
    </div>
  </div>

  <!-- Overview buckets -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-center border-success">
        <div class="card-body">
          <div class="fs-2 fw-bold text-success"><%= overview.normal_count || 0 %></div>
          <div class="text-muted">Normal (&le; 7 days)</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center border-warning">
        <div class="card-body">
          <div class="fs-2 fw-bold text-warning"><%= overview.warning_count || 0 %></div>
          <div class="text-muted">Warning (8–14 days)</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center border-danger">
        <div class="card-body">
          <div class="fs-2 fw-bold text-danger"><%= overview.critical_count || 0 %></div>
          <div class="text-muted">Critical (15–30 days)</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center border-dark">
        <div class="card-body">
          <div class="fs-2 fw-bold text-dark"><%= overview.overdue_count || 0 %></div>
          <div class="text-muted">Overdue (&gt; 30 days)</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header fw-semibold">Open Returns — Sorted by Age</div>
    <div class="table-responsive">
      <table class="table table-hover datatable mb-0">
        <thead class="table-light">
          <tr>
            <th>No Resi</th><th>Description</th><th>Category</th>
            <th>Status</th><th>Return Date</th><th>Created Date</th><th>Aging</th><th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!returns.length) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No aging returns found</td></tr>
          <% } %>
          <% returns.forEach(r => { %>
          <tr>
            <td>
              <% if (r.resi_number) { %>
                <small class="text-muted"><i class="bi bi-truck"></i> <%= r.resi_number %></small>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td><%= r.return_reason ? r.return_reason.substring(0,50) + '...' : '-' %></td>
            <td class="text-capitalize"><%= formatCategory(r.return_category) %></td>

            <td><%- getStatusBadge(r.current_status) %></td>
            <td><%= formatDate(r.return_date) %></td>
            <td><%= formatDate(r.created_at) %></td>
            <td>
              
              <span class="badge bg-<%= getAgingClass(r.aging_days) %>"><%= r.aging_days %> days</span>
            </td>
            <td>
              <a href="/returns/<%= r.return_id %>" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
