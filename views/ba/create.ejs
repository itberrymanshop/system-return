<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h2><i class="bi bi-file-earmark-plus"></i> Buat Berita Acara Baru</h2>
    </div>
    <div class="col-auto">
      <a href="/ba" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <% if (typeof stockItems !== 'undefined' && stockItems.length > 0) { %>
        <div class="card mb-4 border-primary">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bg-primary text-white bi-check-square"></i> Item Stok Terpilih (<%= stockItems.length %> item)</h6>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>No</th>
                  <th>SKU</th>
                  <th>Nama Barang</th>
                  <th>Qty</th>
                  <th>Kategori</th>
                  <th>Vendor</th>
                </tr>
              </thead>
              <tbody>
                <% stockItems.forEach((item, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><span class="badge bg-dark font-monospace"><%= item.sku || item.item_code || '-' %></span></td>
                    <td><strong><%= item.item_name %></strong></td>
                    <td><%= item.quantity %></td>
                    <td class="text-capitalize"><%= item.category.replace(/_/g, ' ') %></td>
                    <td><%= item.vendor_name || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <form method="POST" action="/ba/create">
        <% if (typeof stockIdsParam !== 'undefined' && stockIdsParam) { %>
          <input type="hidden" name="stock_ids" value="<%= stockIdsParam %>">
        <% } %>
        
        <div class="row g-3">

          <div class="col-md-6">
            <label class="form-label">ID Return <%= (typeof stockItems !== 'undefined' && stockItems.length > 0) ? '' : '*' %></label>
            <input type="number" class="form-control" name="return_id" 
              value="<%= returnId || (typeof stockItems !== 'undefined' && stockItems.length > 0 ? stockItems[0].return_id : '') %>" 
              <%= (typeof stockItems !== 'undefined' && stockItems.length > 0) ? 'readonly' : 'required' %>
              placeholder="Masukkan Return ID">
            <small class="text-muted">
              <%= (typeof stockItems !== 'undefined' && stockItems.length > 0) ? 'Diisi otomatis dari item terpilih.' : 'Gunakan Return ID dari halaman detail return.' %>
            </small>
          </div>

          <div class="col-md-6">
            <label class="form-label">Tipe BA <span class="text-danger">*</span></label>
            <select class="form-select" name="ba_type" required>
              <option value="">Pilih Tipe</option>
              <% [['rekondisi','Rekondisi'],['refurbish','Refurbish'],['write_off','Write-Off'],['retur_supplier','Retur Supplier']].forEach(([v,l]) => { %>
                <option value="<%= v %>" <%= (typeof defaultBaType !== 'undefined' && defaultBaType === v) ? 'selected' : '' %>><%= l %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">Judul BA <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="title" required
              placeholder="Contoh: BA Penjualan Refurbish – RET20260529001">
          </div>

          <div class="col-md-6">
            <label class="form-label">Harga Final</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="number" step="0.01" class="form-control" name="final_price" min="0" placeholder="0">
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label">Vendor / Penerima</label>
            <select class="form-select" name="vendor_id">
              <option value="">Tidak ada / Internal</option>
              <% vendors.forEach(v => { %>
                <option value="<%= v.vendor_id %>" <%= (typeof defaultVendorId !== 'undefined' && defaultVendorId == v.vendor_id) ? 'selected' : '' %>><%= v.vendor_name %> (<%= v.vendor_type %>)</option>
              <% }) %>
            </select>
          </div>

          <div class="col-12">
            <label class="form-label">Isi / Kronologi Berita Acara <span class="text-danger">*</span></label>
            <textarea class="form-control" name="content" rows="8" required
              placeholder="Uraikan kronologi, kondisi barang, dasar penetapan harga, kesimpulan, dll."></textarea>
          </div>

        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Simpan sebagai Draft</button>
          <a href="/ba" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>
