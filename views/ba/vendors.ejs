<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h2><i class="bi bi-building"></i> Manajemen Vendor</h2>
    </div>
    <div class="col-auto d-flex gap-2">
      <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addVendorModal">
        <i class="bi bi-plus-circle"></i> Tambah Vendor
      </button>
      <a href="/ba" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover datatable mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th><th>Nama Vendor</th><th>Tipe</th><th>PIC</th>
            <th>Telepon</th><th>Email</th><th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (vendors.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">Belum ada vendor.</td></tr>
          <% } %>
          <% vendors.forEach((v, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><strong><%= v.vendor_name %></strong></td>
            <td>
              <% const vtColors = {refurbish:'warning',write_off:'danger',rekondisi:'primary',general:'secondary'}; %>
              <span class="badge bg-<%= vtColors[v.vendor_type]||'secondary' %>">
                <%= v.vendor_type.replace('_',' ').toUpperCase() %>
              </span>
            </td>
            <td><%= v.contact_person || '-' %></td>
            <td><%= v.phone || '-' %></td>
            <td><%= v.email || '-' %></td>
            <td>
              <button class="btn btn-sm btn-outline-primary"
                data-bs-toggle="modal" data-bs-target="#editVendorModal"
                data-vendor='<%= JSON.stringify(v) %>'>
                <i class="bi bi-pencil"></i>
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Vendor Modal -->
<div class="modal fade" id="addVendorModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/ba/vendors/create">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Tambah Vendor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nama Vendor <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="vendor_name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Tipe <span class="text-danger">*</span></label>
            <select class="form-select" name="vendor_type" required>
              <option value="">Pilih Tipe</option>
              <% [['rekondisi','Rekondisi'],['refurbish','Refurbish'],['write_off','Write-Off'],['general','General']].forEach(([val,lbl]) => { %>
                <option value="<%= val %>"><%= lbl %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Contact Person</label>
            <input type="text" class="form-control" name="contact_person">
          </div>
          <div class="mb-3">
            <label class="form-label">Telepon</label>
            <input type="text" class="form-control" name="phone">
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email">
          </div>
          <div class="mb-3">
            <label class="form-label">Alamat</label>
            <textarea class="form-control" name="address" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Simpan</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Vendor Modal -->
<div class="modal fade" id="editVendorModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editVendorForm" method="POST" action="">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Vendor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="editVendorBody"></div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Update</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('editVendorModal').addEventListener('show.bs.modal', function(e) {
  const v = JSON.parse(e.relatedTarget.dataset.vendor);
  document.getElementById('editVendorForm').action = '/ba/vendors/' + v.vendor_id + '/update';

  const typeOpts = ['rekondisi','refurbish','write_off','general']
    .map(t => `<option value="${t}" ${v.vendor_type===t?'selected':''}>${t.replace('_',' ').toUpperCase()}</option>`).join('');

  document.getElementById('editVendorBody').innerHTML = `
    <div class="mb-3"><label class="form-label">Nama Vendor *</label>
      <input type="text" class="form-control" name="vendor_name" value="${v.vendor_name||''}" required></div>
    <div class="mb-3"><label class="form-label">Tipe *</label>
      <select class="form-select" name="vendor_type" required><option value="">Pilih</option>${typeOpts}</select></div>
    <div class="mb-3"><label class="form-label">Contact Person</label>
      <input type="text" class="form-control" name="contact_person" value="${v.contact_person||''}"></div>
    <div class="mb-3"><label class="form-label">Telepon</label>
      <input type="text" class="form-control" name="phone" value="${v.phone||''}"></div>
    <div class="mb-3"><label class="form-label">Email</label>
      <input type="email" class="form-control" name="email" value="${v.email||''}"></div>
    <div class="mb-3"><label class="form-label">Alamat</label>
      <textarea class="form-control" name="address" rows="2">${v.address||''}</textarea></div>
  `;
});
</script>
