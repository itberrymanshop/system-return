<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-box-arrow-in-down"></i> Inbound Returns</h2>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
          <li class="breadcrumb-item">Returns</li>
          <li class="breadcrumb-item active">Inbound</li>
        </ol>
      </nav>
    </div>
    <div class="col-auto">
      <a href="/returns/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> New Return</a>
    </div>
  </div>

  <div class="card mb-3 border-warning">
    <div class="card-body py-2">
      <span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle"></i></span>
      <span class="ms-1"><%= returns.length %> item(s) retur baru masuk (Inbound) menunggu proses Sorting.</span>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover datatable mb-0">
          <thead class="table-light">
            <tr>
              <th>No Resi / Pesanan</th>
              <th>Date</th>
              <th>Customer</th>
              <th>SKU</th>
              <th>Item Name</th>
              <th>Kondisi</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!returns.length) { %>
              <tr><td colspan="9" class="text-center text-muted py-4">No pending returns</td></tr>
            <% } %>
            <% returns.forEach(r => { %>
              <tr>
                <td>
                  <% if (r.resi_number) { %>
                    <small class="text-muted"><i class="bi bi-truck"></i> <%= r.resi_number %></small>
                  <% } %>
                  <% if (r.no_pesanan) { %>
                    <br><small class="text-muted"><i class="bi bi-receipt"></i> <%= r.no_pesanan %></small>
                  <% } %>
                  <% if (!r.resi_number && !r.no_pesanan) { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td><%= formatDate(r.return_date) %></td>
                <td><%= r.customer_name || '-' %></td>
                <td><a href="/returns/item/<%= r.item_id %>" class="fw-bold text-decoration-none"><code><%= r.item_code || '-' %></code></a></td>
                <td><%= r.item_name %></td>
                <td class="text-capitalize"><%= formatCategory(r.return_category || r.parent_return_category) %></td>
                <td class="text-center"><%= r.quantity %></td>
                <td><%- getStatusBadge(r.disposition === 'restock' ? 'Completed' : r.current_status) %></td>
                <td>
                  <div class="btn-group btn-group-sm">
                    <a href="/returns/item/<%= r.item_id %>" class="btn btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                    <% if (hasRole(['admin','manager','admin_retur'])) { %>
                      <a href="/returns/<%= r.return_id %>/edit?itemId=<%= r.item_id %>" class="btn btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                      <form method="POST" action="/returns/item/<%= r.item_id %>/delete" class="d-inline"
                        onsubmit="return confirm('Hapus item ini dari Inbound Returns? Tindakan ini tidak dapat dibatalkan.');">
                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
