<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-list-ul"></i> All Returns</h2>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
          <li class="breadcrumb-item active">Returns</li>
        </ol>
      </nav>
    </div>
    <div class="col-auto">
      <a href="/returns/create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Return</a>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-header"><h6 class="mb-0"><i class="bi bi-funnel"></i> Filters</h6></div>
    <div class="card-body">
      <form method="GET" action="/returns">
        <div class="row g-2">
          <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" name="status">
              <option value="">All</option>
              <% [['Inbound','Inbound'],['Sorting','Sorting'],['Rekondisi','Rekondisi'],['Refurbish','Refurbish'],['Write_Off','Write Off'],['Pricing','Pricing'],['Recovery','Recovery'],['Completed','Completed'],['Rejected','Rejected'],['Supplier_Return','Supplier Return']].forEach(([v,l]) => { %>
                <option value="<%= v %>" <%= filters.status === v ? 'selected' : '' %>><%= l %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Kondisi</label>
            <select class="form-select form-select-sm" name="category">
              <option value="">All</option>
              <% 
                const categories = [
                  ['baik', 'Baik'],
                  ['kurang_part', 'Kurang Part'],
                  ['packaging_rusak', 'Packaging Rusak'],
                  ['pecah', 'Pecah']
                ];
                categories.forEach(([v, l]) => { 
              %>
                <option value="<%= v %>" <%= filters.category === v ? 'selected' : '' %>><%= l %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Date From</label>
            <input type="date" class="form-control form-control-sm" name="date_from" value="<%= filters.date_from || '' %>">
          </div>
          <div class="col-md-2">
            <label class="form-label">Date To</label>
            <input type="date" class="form-control form-control-sm" name="date_to" value="<%= filters.date_to || '' %>">
          </div>
          <div class="col-md-2 d-flex align-items-end gap-2">
            <button class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Filter</button>
            <a href="/returns" class="btn btn-secondary btn-sm">Reset</a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover datatable mb-0">
          <thead class="table-light">
            <tr>
              <th>No Resi / Pesanan</th>
              <th>Date</th>
              <th>Customer</th>
              <th>SKU</th>
              <th>Item Name</th>
              <th>Kondisi</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!returns.length) { %>
              <tr><td colspan="9" class="text-center text-muted py-4">No returns found</td></tr>
            <% } %>
            <% returns.forEach(r => { %>
              <tr>
                <td>
                  <% if (r.resi_number) { %>
                    <small class="text-muted"><i class="bi bi-truck"></i> <%= r.resi_number %></small>
                  <% } %>
                  <% if (r.no_pesanan) { %>
                    <br><small class="text-muted"><i class="bi bi-receipt"></i> <%= r.no_pesanan %></small>
                  <% } %>
                  <% if (!r.resi_number && !r.no_pesanan) { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td><%= formatDate(r.return_date) %></td>
                <td><%= r.customer_name || '-' %></td>
                <td><a href="/returns/item/<%= r.item_id %>" class="fw-bold text-decoration-none"><code><%= r.item_code || '-' %></code></a></td>
                <td><%= r.item_name %></td>
                <td class="text-capitalize"><%= formatCategory(r.return_category || r.parent_return_category) %></td>
                <td class="text-center"><%= r.quantity %></td>
                <td><%- getStatusBadge(r.disposition === 'restock' ? 'Completed' : r.current_status) %></td>
                <td>
                  <div class="btn-group btn-group-sm">
                    <a href="/returns/item/<%= r.item_id %>" class="btn btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                    <% if (hasRole(['admin','manager','admin_retur']) && (r.disposition === 'restock' ? 'Completed' : r.current_status) !== 'Completed') { %>
                      <a href="/returns/<%= r.return_id %>/edit?itemId=<%= r.item_id %>" class="btn btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
