  function formatDateInput(d) {
    if (!d) return '';
    if (typeof d === 'string' && d.includes('T')) {
      return d.split('T')[0];
    }
    if (typeof d === 'string' && /^\d{4}-\d{2}-\d{2}/.test(d)) {
      return d.substring(0, 10);
    }
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '';
    const y = dt.getFullYear();
    const m = String(dt.getMonth() + 1).padStart(2, '0');
    const day = String(dt.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  // ── Master Barang Autocomplete for Manifest Items ──────────────────────────
  function searchBarangManifest(input, idx, prefix = '') {
    clearTimeout(_barangTimerManifest);
    var q = input.value.trim();
    var isCode = input.classList.contains('item-code-input');
    var dropId = prefix ? (isCode ? 'dropdown-code-' + prefix + '-' + idx : 'dropdown-name-' + prefix + '-' + idx)
                        : (isCode ? 'dropdown-code-' + idx : 'dropdown-name-' + idx);
    var drop = document.getElementById(dropId);
    if (!drop) return;

    if (q.length < 2) {
      drop.classList.add('d-none');
      drop.innerHTML = '';
      return;
    }

    _barangTimerManifest = setTimeout(function () {
      var cacheKey = q.toLowerCase();
      if (_barangCacheManifest[cacheKey]) {
        renderBarangDropManifest(drop, _barangCacheManifest[cacheKey], idx, prefix);
        return;
      }

      fetch('/master-barang/api/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          _barangCacheManifest[cacheKey] = data;
          renderBarangDropManifest(drop, data, idx, prefix);
        })
        .catch(function () {
          drop.classList.add('d-none');
        });
    }, 220);
  }

  function renderBarangDropManifest(drop, items, idx, prefix = '') {
    if (!items || !items.length) {
      drop.classList.add('d-none');
      drop.innerHTML = '';
      return;
    }
    drop.innerHTML = items.map(function (b) {
      return '<div class="barang-drop-item" onmousedown="fillBarangManifest(event,' + idx + ',\'' + prefix + '\')"' +
        ' data-kode="' + escAttr(b.kode_barang) + '"' +
        ' data-nama="' + escAttr(b.nama_barang) + '">' +
        '<span class="fw-semibold text-primary">' + esc(b.kode_barang) + '</span> &mdash; ' + esc(b.nama_barang) +
        (b.kategori ? ' <span class="badge bg-light text-secondary border ms-1">' + esc(b.kategori) + '</span>' : '') +
        '</div>';
    }).join('');
    drop.classList.remove('d-none');
  }

  function fillBarangManifest(e, idx, prefix = '') {
    e.preventDefault();
    var item = e.currentTarget;
    var rowId = prefix ? (prefix + '-manifest-item-' + idx) : ('manifest-item-' + idx);
    var row = document.getElementById(rowId);
    if (!row) return;
    var codeInput = row.querySelector('.item-code-input');
    var nameInput = row.querySelector('.item-name-input');
    if (codeInput) codeInput.value = item.dataset.kode;
    if (nameInput) nameInput.value = item.dataset.nama;
    // Close all dropdowns for this row
    var codeDropId = prefix ? ('dropdown-code-' + prefix + '-' + idx) : ('dropdown-code-' + idx);
    var nameDropId = prefix ? ('dropdown-name-' + prefix + '-' + idx) : ('dropdown-name-' + idx);
    [codeDropId, nameDropId].forEach(function (id) {
      var d = document.getElementById(id);
      if (d) { d.classList.add('d-none'); d.innerHTML = ''; }
    });
  }

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = String(s || '');
    return d.innerHTML;
  }

  function escAttr(s) {
    return String(s || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

