<script>
  // ── Tambah Data Manifest: dynamic item rows ─────────────────────────────────
  var manifestItemCounter = 0;
  var editManifestItemCounter = 0;
  var _barangCacheManifest = {};
  var _barangTimerManifest = null;

  function addManifestItemRow() {
    manifestItemCounter++;
    const idx = manifestItemCounter;
    const container = document.getElementById('manifestItemsContainer');
    const div = document.createElement('div');
    div.className = 'item-row border rounded-3 p-3 mb-2 bg-light shadow-sm position-relative';
