    $('#manifestsTable').on('change', '.manifest-pic-checkbox', function () {
      const checkbox = $(this);
      const manifestId = checkbox.data('id');
      const picType = checkbox.data('pic');
      const isChecked = checkbox.is(':checked');
      const cell = checkbox.closest('td');
      const badgeContainer = cell.find('.pic-badge-container');
      const tr = checkbox.closest('tr');

      checkbox.prop('disabled', true);

      fetch(`/returns/manifests/${manifestId}/toggle-pic-check`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ picType, isChecked })
      })
        .then(res => {
          if (!res.ok) {
            return res.json().then(d => { throw new Error(d.error || 'Gagal memperbarui status checklist PIC.'); });
          }
          return res.json();
        })
        .then(data => {
          checkbox.prop('disabled', false);
          if (data.success) {
            if (data.is_checked) {
              const dateStr = data.checked_at ? new Date(data.checked_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '';
              badgeContainer.html(`
                <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;" title="Diperiksa oleh: ${data.checked_by || ''} (${dateStr})">
                  <i class="bi bi-check-circle-fill"></i> ${data.checked_by || 'Checked'}
                </span>
              `);
              checkbox.attr('title', `Diperiksa oleh: ${data.checked_by || ''} (${dateStr})`);
            } else {
              badgeContainer.html(`<span class="badge bg-light text-muted border" style="font-size: 0.65rem;">Belum</span>`);
              checkbox.attr('title', `Pengecekan PIC ${picType.toUpperCase()}`);
            }

            // Update row tint
            const salesChecked = tr.find('[data-pic="sales"]').is(':checked');
            const fatChecked = tr.find('[data-pic="fat"]').is(':checked');
            const opsChecked = tr.find('[data-pic="ops"]').is(':checked');
            if (salesChecked && fatChecked && opsChecked) {
              tr.removeClass('table-warning-tint').addClass('table-success-tint');
            } else if (salesChecked || fatChecked || opsChecked) {
              tr.removeClass('table-success-tint').addClass('table-warning-tint');
            } else {
              tr.removeClass('table-success-tint table-warning-tint');
            }
          }
        })
        .catch(err => {
          checkbox.prop('disabled', false);
          checkbox.prop('checked', !isChecked); // revert checkbox state
          alert(err.message);
        });
    });

    // Event listener for toggling Banding MP PIC checkbox (Sales, FAT)
    $('#manifestsTable').on('change', '.banding-pic-checkbox', function () {
