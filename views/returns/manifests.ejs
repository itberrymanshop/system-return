<style>
  .manifest-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 1rem;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .drag-drop-area {
    border: 2px dashed #0d6efd;
    border-radius: 0.5rem;
    padding: 1.5rem 1rem;
    text-align: center;
    background: #f8faff;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .drag-drop-area:hover,
  .drag-drop-area.dragover {
    background: #eef4ff;
    border-color: #0a58ca;
  }

  .stats-value {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .toggle-items {
    padding: 0.15rem 0.35rem;
    font-size: 0.75rem;
  }

  /* Autocomplete Dropdown for Master Barang */
  .barang-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1060;
    background: #fff;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    max-height: 220px;
    overflow-y: auto;
  }

  .barang-drop-item {
    padding: 7px 12px;
    cursor: pointer;
    font-size: 0.82rem;
    border-bottom: 1px solid #f0f0f0;
    text-align: left;
    transition: background-color 0.15s ease;
  }

  .barang-drop-item:last-child {
    border-bottom: none;
  }

  .barang-drop-item:hover,
  .barang-drop-item:focus {
    background-color: #f0f4ff;
  }

  /* Premium Responsive Pagination styling */
  .responsive-pagination .page-item .page-link {
    border: 1px solid #e2e8f0;
    color: #4a5568;
    background-color: #fff;
    margin: 0 3px;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
  }

  .responsive-pagination .page-item.active .page-link {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 4px 6px -1px rgba(102, 126, 234, 0.25), 0 2px 4px -1px rgba(102, 126, 234, 0.1);
  }

  .responsive-pagination .page-item:not(.active):not(.disabled) .page-link:hover {
    background-color: #f7fafc;
    border-color: #cbd5e0;
    color: #1a202c;
  }

  .responsive-pagination .page-item.disabled .page-link {
    color: #a0aec0;
    background-color: #edf2f7;
    border-color: #e2e8f0;
  }

  /* Table styling */
  #manifestsTable {
    border-collapse: separate;
    border-spacing: 0;
  }

  #manifestsTable thead th {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    border-bottom: 2px solid #e2e8f0;
    padding: 12px 16px;
  }

  #manifestsTable tbody tr {
    transition: background-color 0.2s ease;
  }

  #manifestsTable tbody tr:hover {
    background-color: #f8fafc;
  }

  #manifestsTable td {
    padding: 14px 16px;
    border-bottom: 1px solid #f1f5f9;
  }

  /* Details row styling */
  .items-detail-row {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive tweaks for tables & search bar */
  @media (max-width: 768px) {
    #searchFilterForm {
      width: 100%;
      flex-direction: column;
      align-items: stretch !important;
    }

    #searchFilterForm>* {
      width: 100%;
      max-width: none !important;
    }

    .responsive-pagination .page-item .page-link {
      margin: 0 1px;
      padding: 0.25rem 0.5rem;
      font-size: 0.8rem;
    }
  }

  .table-success-tint {
    background-color: rgba(25, 135, 84, 0.08) !important;
  }
  .table-warning-tint {
    background-color: rgba(255, 193, 7, 0.08) !important;
  }
  .pic-check-cell {
    vertical-align: middle !important;
    padding: 6px 6px !important;
  }
  .pic-check-cell .form-check-input {
    cursor: pointer;
    width: 2em;
    height: 1.1em;
  }
  .pic-badge-container {
    min-height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The <form> wrapping header/body/footer breaks modal-dialog-scrollable's flex
     chain (it can't shrink below its content), so the modal body never scrolls
     and just gets clipped. Turn the form into the flex container instead. */
  .modal-dialog-scrollable .modal-content {
    height: 100%;
  }

  .modal-dialog-scrollable .modal-content>form {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  /* Select2 Styling in Modals */
  .select2-container--bootstrap-5 .select2-results__option {
    white-space: normal;
    word-break: break-word;
    font-size: 0.85rem;
    line-height: 1.35;
    padding: 0.45rem 0.65rem;
  }
  .select2-container--bootstrap-5 .select2-selection--single {
    font-size: 0.85rem;
    height: calc(1.5em + 0.5rem + 2px);
    padding: 0.25rem 0.5rem;
  }
  .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
    line-height: 1.5;
    padding-left: 0;
  }
</style>

<div class="container-fluid mt-5 pt-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12 col-md-6">
      <h2><i class="bi bi-file-earmark-excel text-primary"></i> Return Manifests Dashboard</h2>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/returns">Returns</a></li>
          <li class="breadcrumb-item active">Manifests</li>
        </ol>
      </nav>
    </div>
    <div
      class="col-12 col-md-6 text-md-end mt-2 mt-md-0 d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
      <button type="button" class="btn btn-warning text-dark fw-semibold" data-bs-toggle="modal" data-bs-target="#addBandingMPModal">
        <i class="bi bi-shield-plus"></i> Tambah Data Banding MP
      </button>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addManifestModal">
        <i class="bi bi-plus-lg"></i> Tambah Data Manifest
      </button>
      <% if (stats.pendingManifests> 0) { %>
        <button type="button" class="btn btn-outline-danger" id="deleteAllPendingBtn">
          <i class="bi bi-trash-fill"></i> Hapus Semua Pending
        </button>
        <% } %>
          <a href="/returns/manifests/export?tab=<%= activeTab %><%= pagination.search ? '&search=' + encodeURIComponent(pagination.search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Export Excel <%= activeTab === 'manual' ? 'Data By Manual' : (activeTab === 'banding' ? 'Data Banding MP' : 'Data By Scan') %>
          </a>
    </div>
  </div>

  <!-- Stats Cards -->
  <% const totalOverall=stats.pendingManifests + stats.processedManifests; const scanPercentage=totalOverall> 0 ?
    ((stats.processedManifests / totalOverall) * 100).toFixed(1) : "0.0";
    %>
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div
          class="card manifest-card border-start border-primary border-4 p-3 d-flex flex-row align-items-center justify-content-between">
          <div>
            <div class="text-muted small uppercase fw-semibold">Total Manifests</div>
            <div class="stats-value text-primary mt-1">
              <%= totalOverall %>
            </div>
          </div>
          <div class="fs-1 text-primary-emphasis opacity-50"><i class="bi bi-folder-fill"></i></div>
        </div>
      </div>
      <div class="col-md-3">
        <div
          class="card manifest-card border-start border-warning border-4 p-3 d-flex flex-row align-items-center justify-content-between">
          <div>
            <div class="text-muted small uppercase fw-semibold">Pending (Belum Di-scan)</div>
            <div class="stats-value text-warning mt-1">
              <%= stats.pendingManifests %>
            </div>
          </div>
          <div class="fs-1 text-warning-emphasis opacity-50"><i class="bi bi-hourglass-split"></i></div>
        </div>
      </div>
      <div class="col-md-3">
        <div
          class="card manifest-card border-start border-success border-4 p-3 d-flex flex-row align-items-center justify-content-between">
          <div>
            <div class="text-muted small uppercase fw-semibold">Processed (Sudah Di-scan)</div>
            <div class="stats-value text-success mt-1">
              <%= stats.processedManifests %>
            </div>
          </div>
          <div class="fs-1 text-success-emphasis opacity-50"><i class="bi bi-patch-check-fill"></i></div>
        </div>
      </div>
      <div class="col-md-3">
        <div
          class="card manifest-card border-start border-info border-4 p-3 d-flex flex-row align-items-center justify-content-between">
          <div>
            <div class="text-muted small uppercase fw-semibold">Persentase Scan</div>
            <div class="stats-value text-info mt-1">
              <%= scanPercentage %>%
            </div>
          </div>
          <!-- <div class="fs-1 text-info-emphasis opacity-50"><i class="bi bi-percent"></i></div> -->
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="row g-4">
      <!-- Left Column: Manifests List Table -->
      <div class="col-lg-8 mb-4">
        <div class="card manifest-card p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h5 class="card-title mb-0">Daftar Data Return Manifest</h5>
            <a href="/returns/manifests/export?tab=<%= activeTab %><%= pagination.search ? '&search=' + encodeURIComponent(pagination.search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>"
              class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm"
              title="Export <%= activeTab === 'manual' ? 'Data By Manual' : (activeTab === 'banding' ? 'Data Banding MP' : 'Data By Scan') %> ke Excel">
              <i class="bi bi-file-earmark-excel"></i> Export Excel (<%= activeTab === 'manual' ? 'Data By Manual' : (activeTab === 'banding' ? 'Data Banding MP' : 'Data By Scan') %>)
            </a>
          </div>

          <!-- Navigation Tabs: Data By Scan, Data By Manual & Data Banding MP -->
          <ul class="nav nav-pills mb-3 gap-2 border-bottom pb-3" id="manifestTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <a class="nav-link <%= activeTab === 'scan' ? 'active' : 'bg-light text-dark' %> fw-semibold d-flex align-items-center py-2 px-3 rounded-3 shadow-none border"
                href="/returns/manifests?tab=scan<%= pagination.search ? '&search=' + encodeURIComponent(pagination.search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= pagination.limit %>">
                <i class="bi bi-upc-scan me-2"></i> Data By Scan
                <span
                  class="badge <%= activeTab === 'scan' ? 'bg-white text-primary' : 'bg-secondary' %> rounded-pill ms-2">
                  <%= tabCounts.scan %>
                </span>
              </a>
            </li>
            <li class="nav-item" role="presentation">
              <a class="nav-link <%= activeTab === 'manual' ? 'active' : 'bg-light text-dark' %> fw-semibold d-flex align-items-center py-2 px-3 rounded-3 shadow-none border"
                href="/returns/manifests?tab=manual<%= pagination.search ? '&search=' + encodeURIComponent(pagination.search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= pagination.limit %>">
                <i class="bi bi-pencil-square me-2"></i> Data By Manual
                <span
                  class="badge <%= activeTab === 'manual' ? 'bg-white text-primary' : 'bg-secondary' %> rounded-pill ms-2">
                  <%= tabCounts.manual %>
                </span>
              </a>
            </li>
            <li class="nav-item" role="presentation">
              <a class="nav-link <%= activeTab === 'banding' ? 'active' : 'bg-light text-dark' %> fw-semibold d-flex align-items-center py-2 px-3 rounded-3 shadow-none border"
                href="/returns/manifests?tab=banding<%= pagination.search ? '&search=' + encodeURIComponent(pagination.search) : '' %><%= startDate ? '&startDate=' + startDate : '' %><%= endDate ? '&endDate=' + endDate : '' %>&limit=<%= pagination.limit %>">
                <i class="bi bi-shield-exclamation me-2"></i> Data Banding MP
                <span
                  class="badge <%= activeTab === 'banding' ? 'bg-white text-primary' : 'bg-secondary' %> rounded-pill ms-2">
                  <%= tabCounts.banding || 0 %>
                </span>
              </a>
            </li>
          </ul>

          <!-- Search & Pagination Header -->
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <form method="GET" action="/returns/manifests" class="d-flex align-items-center flex-wrap gap-2"
              id="searchFilterForm">
              <input type="hidden" name="tab" value="<%= activeTab %>">
              <div class="input-group input-group-sm" style="max-width: 270px;">
                <input type="text" name="search" class="form-control" placeholder="<%= activeTab === 'banding' ? 'Cari Invoice / Toko / Status...' : 'Cari Resi / No Pesanan...' %>"
                  value="<%= pagination.search %>">
                <button type="submit" class="btn btn-primary px-3"><i class="bi bi-search"></i> Cari</button>
              </div>
              <% if (pagination.search || startDate || endDate) { %>
                <a href="/returns/manifests?tab=<%= activeTab %>&limit=<%= pagination.limit %>"
                  class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center text-decoration-none"
                  style="height: 31px;">Reset</a>
                <% } %>

                  <div class="d-flex align-items-center gap-1 ms-md-2">
                    <span class="text-muted small text-nowrap">Dari:</span>
                    <input type="date" name="startDate" class="form-control form-control-sm" style="width: 135px;"
                      value="<%= startDate %>" onchange="this.form.submit()">
                  </div>

                  <div class="d-flex align-items-center gap-1 ms-md-2">
                    <span class="text-muted small text-nowrap">Sampai:</span>
                    <input type="date" name="endDate" class="form-control form-control-sm" style="width: 135px;"
                      value="<%= endDate %>" onchange="this.form.submit()">
                  </div>

                  <button type="button" class="btn btn-outline-danger btn-sm px-3 d-flex align-items-center d-none"
                    id="clearScannedBtn" style="height: 31px;">
                    <i class="bi bi-trash me-1"></i> Hapus Riwayat Scan
                  </button>

                  <div class="d-flex align-items-center gap-1 ms-md-2">
                    <span class="text-muted small text-nowrap">Tampilkan:</span>
                    <select name="limit" class="form-select form-select-sm" style="width: 80px;"
                      onchange="this.form.submit()">
                      <% [5, 10, 15, 25, 50, 100].forEach(l=> { %>
                        <option value="<%= l %>" <%=pagination.limit===l ? 'selected' : '' %>><%= l %>
                        </option>
                        <% }) %>
                    </select>
                  </div>
            </form>
            <div class="text-muted small">
              <% if (pagination.total> 0) { %>
                Menampilkan <strong>
                  <%= (pagination.page - 1) * pagination.limit + 1 %>
                </strong> - <strong>
                  <%= Math.min(pagination.page * pagination.limit, pagination.total) %>
                </strong> dari <strong>
                  <%= pagination.total %>
                </strong> data
                <% } else { %>
                  Tidak ada data.
                  <% } %>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle small" id="manifestsTable" style="width: 100%;">
              <thead class="table-light">
                <% if (activeTab === 'banding') { %>
                  <tr>
                    <th style="width: 40px;" class="text-center">No</th>
                    <th style="min-width: 110px;">Tgl</th>
                    <th style="min-width: 130px;">Kode Toko</th>
                    <th style="min-width: 140px;">Nomer Invoice</th>
                    <th style="min-width: 250px;">Keterangan</th>
                    <th style="min-width: 170px;" class="text-center">Status Banding</th>
                    <th class="text-center" style="min-width: 100px;">
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i>PIC SALES</span>
                    </th>
                    <th class="text-center" style="min-width: 100px;">
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-wallet2 me-1"></i>PIC FAT</span>
                    </th>
                    <th style="width: 90px;" class="text-center">Aksi</th>
                  </tr>
                <% } else if (activeTab==='manual' ) { %>
                  <tr>
                    <th style="width: 30px;"></th>
                    <th>Tgl</th>
                    <th>Nama Customer</th>
                    <th>Kota</th>
                    <th>Exspedisi</th>
                    <th>Toko</th>
                    <th>No Pesanan</th>
                    <th>Nomor Resi</th>
                    <th>Status</th>
                    <th>Jml Barang</th>
                    <th class="text-center" style="min-width: 100px;">
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i>PIC SALES</span>
                    </th>
                    <th class="text-center" style="min-width: 100px;">
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-wallet2 me-1"></i>PIC FAT</span>
                    </th>
                    <th class="text-center" style="min-width: 100px;">
                      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1"><i class="bi bi-gear-wide-connected me-1"></i>PIC OPS</span>
                    </th>
                    <th style="width: 80px;" class="text-center">Aksi</th>
                  </tr>
                  <% } else { %>
                    <tr>
                      <th style="width: 30px;"></th>
                      <th>Resi / Order No</th>
                      <th>Customer</th>
                      <th>Pengirim</th>
                      <th>Kategori</th>
                      <th>Jml Barang</th>
                      <th>Status</th>
                      <th>Tgl Upload</th>
                      <th class="text-center" style="min-width: 100px;">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i>PIC SALES</span>
                      </th>
                      <th class="text-center" style="min-width: 100px;">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-wallet2 me-1"></i>PIC FAT</span>
                      </th>
                      <th class="text-center" style="min-width: 100px;">
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1"><i class="bi bi-gear-wide-connected me-1"></i>PIC OPS</span>
                      </th>
                      <th style="width: 70px;" class="text-center">Aksi</th>
                    </tr>
                    <% } %>
              </thead>
              <tbody>
                <% if (activeTab === 'banding') { %>
                  <% if (!bandingList || bandingList.length === 0) { %>
                    <tr>
                      <td colspan="9" class="text-center text-muted py-4">
                        <% if (pagination.search) { %>
                          <i class="bi bi-exclamation-circle fs-3 d-block mb-2 text-danger"></i>
                          Tidak ada data Banding MP ditemukan untuk pencarian "<strong><%= pagination.search %></strong>".
                        <% } else { %>
                          <i class="bi bi-shield-slash fs-3 d-block mb-2 text-muted"></i>
                          Belum ada data Banding MP. Klik tombol <strong>Tambah Data Banding MP</strong> di atas untuk menambahkan data baru.
                        <% } %>
                      </td>
                    </tr>
                  <% } else { %>
                    <% bandingList.forEach((bmp, idx) => { %>
                      <%
                        const isBmpAllChecked = (bmp.check_sales === 1 && bmp.check_fat === 1);
                        const hasBmpAnyChecked = (bmp.check_sales === 1 || bmp.check_fat === 1);
                        let statusBadgeClass = 'bg-secondary';
                        let statusIcon = 'bi-info-circle';
                        if (bmp.status_banding === 'Dana Dicairkan Ke Penjual') {
                          statusBadgeClass = 'bg-success text-white';
                          statusIcon = 'bi-check-circle-fill';
                        } else if (bmp.status_banding === 'Banding Ditolak') {
                          statusBadgeClass = 'bg-danger text-white';
                          statusIcon = 'bi-x-circle-fill';
                        } else if (bmp.status_banding === 'Dana Dikembalikan Ke Pembeli') {
                          statusBadgeClass = 'bg-warning text-dark';
                          statusIcon = 'bi-arrow-counterclockwise';
                        }
                        const formattedBmpDate = bmp.tgl ? new Date(bmp.tgl).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-';
                        const rawDate = bmp.tgl ? new Date(bmp.tgl).toISOString().split('T')[0] : '';
                        const canCheckPicBmp = hasRole(['admin', 'manager', 'purchasing', 'sales', 'admin_retur', 'admin_sorting', 'staff_recover', 'warehouse', 'inspector']);
                      %>
                      <tr id="banding-row-<%= bmp.id %>" class="align-middle <%= isBmpAllChecked ? 'table-success-tint' : (hasBmpAnyChecked ? 'table-warning-tint' : '') %>">
                        <td class="text-center text-muted fw-semibold"><%= (pagination.page - 1) * pagination.limit + idx + 1 %></td>
                        <td>
                          <span class="text-nowrap"><i class="bi bi-calendar3 me-1 text-muted"></i><%= formattedBmpDate %></span>
                        </td>
                        <td>
                          <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-shop me-1 text-primary"></i><%= bmp.kode_toko %></span>
                        </td>
                        <td>
                          <span class="fw-bold font-monospace text-primary"><%= bmp.no_invoice %></span>
                        </td>
                        <td>
                          <span class="text-secondary small"><%= bmp.keterangan %></span>
                        </td>
                        <td class="text-center">
                          <span class="badge <%= statusBadgeClass %> px-2 py-1 rounded-pill">
                            <i class="bi <%= statusIcon %> me-1"></i><%= bmp.status_banding %>
                          </span>
                        </td>

                        <!-- PIC SALES Checkbox for Banding MP -->
                        <td class="text-center pic-check-cell" data-banding-id="<%= bmp.id %>" data-pic="sales">
                          <div class="d-flex flex-column align-items-center justify-content-center">
                            <div class="form-check form-switch mb-1">
                              <input type="checkbox" class="form-check-input banding-pic-checkbox"
                                data-id="<%= bmp.id %>"
                                data-pic="sales"
                                <%= bmp.check_sales === 1 ? 'checked' : '' %>
                                <%= canCheckPicBmp ? '' : 'disabled' %>
