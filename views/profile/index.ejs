<div class="container-fluid mt-5 pt-4" style="max-width:820px">
  <h2 class="mb-1"><i class="bi bi-person-circle"></i> My Profile</h2>
  <p class="text-muted mb-4">Manage your account information and change your password.</p>

  <div class="row g-4">
    <!-- Profile Info -->
    <div class="col-md-7">
      <div class="card">
        <div class="card-header fw-semibold">Account Information</div>
        <div class="card-body">
          <form method="POST" action="/profile/update">
            <div class="mb-3">
              <label class="form-label">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="full_name" value="<%= profileUser.full_name %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input type="text" class="form-control" value="<%= profileUser.username %>" disabled>
              <div class="form-text">Username cannot be changed.</div>
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" value="<%= profileUser.email || '' %>">
            </div>
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input type="text" class="form-control" name="phone" value="<%= profileUser.phone || '' %>">
            </div>
            <div class="mb-3">
              <label class="form-label">Department</label>
              <input type="text" class="form-control" name="department" value="<%= profileUser.department || '' %>">
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span class="badge bg-<%= profileUser.role === 'admin' ? 'danger' : profileUser.role === 'manager' ? 'warning' : 'info' %> text-capitalize me-1"><%= profileUser.role %></span>
                <span class="badge bg-<%= profileUser.is_active ? 'success' : 'secondary' %>"><%= profileUser.is_active ? 'Active' : 'Inactive' %></span>
              </div>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Change Password -->
    <div class="col-md-5">
      <div class="card">
        <div class="card-header fw-semibold">Change Password</div>
        <div class="card-body">
          <form method="POST" action="/profile/change-password">
            <div class="mb-3">
              <label class="form-label">Current Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" name="current_password" required>
            </div>
            <div class="mb-3">
              <label class="form-label">New Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" name="new_password" id="newPw" required minlength="6">
              <div class="form-text">Minimum 6 characters.</div>
            </div>
            <div class="mb-4">
              <label class="form-label">Confirm New Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" name="confirm_password" id="confirmPw" required minlength="6">
            </div>
            <button type="submit" class="btn btn-warning w-100">Change Password</button>
          </form>
        </div>
      </div>

      <!-- Account Stats -->
      <div class="card mt-3">
        <div class="card-body">
          <div class="text-muted small mb-2">Account Details</div>
          <dl class="row mb-0 small">
            <dt class="col-sm-6">Last Login</dt>
            <dd class="col-sm-6"><%= profileUser.last_login ? formatDateTime(profileUser.last_login) : 'N/A' %></dd>
            <dt class="col-sm-6">Member Since</dt>
            <dd class="col-sm-6"><%= formatDate(profileUser.created_at) %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Client-side password match validation
document.querySelector('form[action="/profile/change-password"]').addEventListener('submit', function(e) {
  const pw = document.getElementById('newPw').value;
  const cp = document.getElementById('confirmPw').value;
  if (pw !== cp) {
    e.preventDefault();
    document.getElementById('confirmPw').setCustomValidity('Passwords do not match');
    document.getElementById('confirmPw').reportValidity();
  }
});
document.getElementById('confirmPw').addEventListener('input', function() {
  this.setCustomValidity('');
});
</script>
