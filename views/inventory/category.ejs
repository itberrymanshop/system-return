<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h2>
        <% const catConf = {rekondisi:['primary','bi-tools'],refurbish:['warning','bi-stars'],write_off:['danger','bi-trash3'],stok_utama:['success','bi-archive'],return_to_supplier:['secondary','bi-truck']}; %>
        <% const [catColor, catIcon] = catConf[category] || ['secondary','bi-box']; %>
        <% const catNames = { rekondisi: 'Rekondisi', refurbish: 'Refurbish', write_off: 'Write Off', stok_utama: 'Utama', return_to_supplier: 'Supplier Lokal' }; %>
        <i class="bi <%= catIcon %> text-<%= catColor %>"></i>
        Stok <%= catNames[category] || category.replace('_', ' ') %>
      </h2>
    </div>
    <div class="col-auto d-flex gap-2">
      <% if (['rekondisi', 'refurbish', 'write_off', 'return_to_supplier'].includes(category)) { %>
        <button id="btn-bulk-ba" class="btn btn-sm btn-primary d-none" onclick="submitBulkBA()">
          <i class="bi bi-file-earmark-plus"></i> Buat Berita Acara (<span id="selected-count">0</span>)
        </button>
      <% } %>
      <a href="/inventory" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <% if (category === 'return_to_supplier') { %>
  <div class="alert alert-info mb-3" role="alert">
    <i class="bi bi-info-circle"></i> <strong>Informasi:</strong> Pilih SKU Supplier Lokal lalu klik <strong>Buat Berita Acara</strong> untuk memindahkan item ke dokumen BA dan memperbarui status stok menjadi completed.
  </div>
  <% } %>

  <div class="card">
    <div class="card-header d-flex justify-content-between">
      <h6 class="mb-0">Daftar Stok</h6>
      <span class="badge bg-secondary"><%= items.length %> item</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover datatable mb-0">
        <thead class="table-light">
          <tr>
            <% if (['rekondisi', 'refurbish', 'write_off', 'return_to_supplier'].includes(category)) { %>
              <th class="text-center" style="width: 40px;"><input type="checkbox" id="check-all-items"></th>
            <% } else if (category === 'return_to_supplier') { %>
              <th>#</th>
            <% } else { %>
              <th>#</th>
            <% } %>
            <th>No Resi</th><th>Item</th><th>SKU</th>
            <% if (category === 'return_to_supplier') { %>
              <th>Kondisi</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Tanggal Input</th>
              <th>Vendor</th>
            <% } else if (['rekondisi', 'refurbish'].includes(category)) { %>
              <th>Kondisi</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Tanggal Input</th>
              <th>SLA</th>
            <% } else if (category === 'write_off') { %>
              <th>Kondisi</th>
              <th>Qty</th>
              <th>Status</th>
              <th>Tanggal Input</th>
            <% } else { %>
              <th>Lokasi</th><th>Status</th><th>Harga Jual</th><th>Tgl Jual</th><th>Vendor</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (items.length === 0) { %>
            <% const emptyColspan = ['rekondisi', 'refurbish'].includes(category) ? 9 : 8; %>
            <tr><td colspan="<%= emptyColspan %>" class="text-center text-muted py-4">Stok kosong.</td></tr>
          <% } %>
          <% items.forEach((item, i) => { %>
          <tr>
            <% if (['rekondisi', 'refurbish', 'write_off', 'return_to_supplier'].includes(category)) { %>
              <td class="text-center">
                <% if (item.status === 'tersedia') { %>
                  <input type="checkbox" class="item-checkbox" data-stock-id="<%= item.stock_id %>">
                <% } else { %>
                  <input type="checkbox" class="item-checkbox" disabled title="Hanya item dengan status tersedia yang dapat dipilih">
                <% } %>
              </td>
            <% } else { %>
              <td><%= i + 1 %></td>
            <% } %>
            <td>
              <% if (item.resi_number) { %>
                <small class="text-muted"><i class="bi bi-truck"></i> <%= item.resi_number %></small>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <strong><%= item.item_name %></strong>
              <% if (item.serial_number) { %><br><small class="text-muted">S/N: <%= item.serial_number %></small><% } %>
              <% if (item.sticker_tag) { %>
                <br><span class="badge bg-warning text-dark"><i class="bi bi-tag"></i> <%= item.sticker_tag %></span>
              <% } %>
            </td>
            <td><small><%= item.sku || item.item_code || '-' %></small></td>
            <% if (category === 'return_to_supplier') { %>
              <td class="text-capitalize"><%= formatCategory(item.return_category) %></td>
              <td><%= item.quantity %></td>
              <td>
                <% const stColors = {tersedia:'success',terjual:'primary',diproses:'info',void:'secondary',completed:'warning'}; %>
                <span class="badge bg-<%= stColors[item.status]||'secondary' %>"><%= item.status %></span>
              </td>
              <td><small><%= item.item_created_at ? formatDate(item.item_created_at) : '-' %></small></td>
              <td><small><%= item.vendor_name || '-' %></small></td>
            <% } else if (['rekondisi', 'refurbish'].includes(category)) { %>
              <td class="text-capitalize"><%= formatCategory(item.return_category) %></td>
              <td><%= item.quantity %></td>
              <td>
                <% const stColors = {tersedia:'success',terjual:'primary',diproses:'info',void:'secondary',completed:'warning'}; %>
                <span class="badge bg-<%= stColors[item.status]||'secondary' %>"><%= item.status %></span>
              </td>
              <td><small><%= item.item_created_at ? formatDate(item.item_created_at) : '-' %></small></td>
              <td>
                <% if (item.sla_deadline && item.slaInfo) { %>
                  <span class="badge bg-<%= item.slaInfo.color %>"><i class="bi bi-clock"></i> <%= item.slaInfo.label %></span>
                  <div><small class="text-muted"><%= formatDate(item.sla_deadline) %></small></div>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
            <% } else if (category === 'write_off') { %>
              <td class="text-capitalize"><%= formatCategory(item.return_category) %></td>
              <td><%= item.quantity %></td>
              <td>
                <% const stColors = {tersedia:'success',terjual:'primary',diproses:'info',void:'secondary',completed:'warning'}; %>
                <span class="badge bg-<%= stColors[item.status]||'secondary' %>"><%= item.status %></span>
              </td>
              <td><small><%= item.item_created_at ? formatDate(item.item_created_at) : '-' %></small></td>
            <% } else { %>
              <td><%= item.location || '-' %></td>
              <td>
                <% const stColors = {tersedia:'success',terjual:'primary',diproses:'info',void:'secondary',completed:'warning'}; %>
                <span class="badge bg-<%= stColors[item.status]||'secondary' %>"><%= item.status %></span>
              </td>
              <td><%= item.sale_price ? formatCurrency(item.sale_price) : '-' %></td>
              <td><small><%= item.sale_date ? formatDate(item.sale_date) : '-' %></small></td>
              <td><small><%= item.vendor_name || '-' %></small></td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (['rekondisi', 'refurbish', 'write_off', 'return_to_supplier'].includes(category)) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const checkAll = document.getElementById('check-all-items');
    const checkboxes = document.querySelectorAll('.item-checkbox:not(:disabled)');
    const bulkButton = document.getElementById('btn-bulk-ba');
    const selectedCount = document.getElementById('selected-count');

    if (checkAll) {
      checkAll.addEventListener('change', function() {
        checkboxes.forEach(cb => {
          cb.checked = this.checked;
        });
        updateBulkButton();
      });
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateBulkButton);
    });

    function updateBulkButton() {
      const checked = document.querySelectorAll('.item-checkbox:checked');
      if (checked.length > 0) {
        bulkButton.classList.remove('d-none');
        selectedCount.textContent = checked.length;
      } else {
        bulkButton.classList.add('d-none');
        selectedCount.textContent = '0';
      }
    }
  });

  function submitBulkBA() {
    const checked = document.querySelectorAll('.item-checkbox:checked');
    const stockIds = Array.from(checked).map(cb => cb.getAttribute('data-stock-id'));
    if (stockIds.length === 0) return;
    
    window.location.href = '/ba/create?stock_ids=' + stockIds.join(',');
  }
</script>
<% } %>

