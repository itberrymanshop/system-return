<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h2><i class="bi bi-building"></i> Master Supplier</h2>
      <p class="text-muted">Kelola data supplier untuk return dan inventory.</p>
    </div>
    <div class="col-auto d-flex gap-2">
      <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
        <i class="bi bi-plus-circle"></i> Tambah Supplier
      </button>
      <a href="/dashboard" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <!-- Search & Filter -->
  <div class="card mb-3">
    <div class="card-body py-2">
      <form method="GET" action="/master-supplier" class="row g-2 align-items-center">
        <div class="col-md-4">
          <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" name="search" placeholder="Cari nama, PIC, atau email..." value="<%= filters.search || '' %>">
          </div>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-sm btn-primary">Filter</button>
          <a href="/master-supplier" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover datatable mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Nama Supplier</th>
            <th>Tipe</th>
            <th>PIC</th>
            <th>Telepon</th>
            <th>Email</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">Belum ada data supplier.</td></tr>
          <% } %>
          <% items.forEach((item, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><strong><%= item.vendor_name %></strong></td>
            <td>
              <% const vtColors = {refurbish:'warning',write_off:'danger',rekondisi:'primary',general:'secondary'}; %>
              <span class="badge bg-<%= vtColors[item.vendor_type]||'secondary' %>">
                <%= item.vendor_type.replace('_',' ').toUpperCase() %>
              </span>
            </td>
            <td><%= item.contact_person || '-' %></td>
            <td><%= item.phone || '-' %></td>
            <td><%= item.email || '-' %></td>
            <td>
              <span class="badge bg-<%= item.is_active ? 'success' : 'danger' %>">
                <%= item.is_active ? 'Aktif' : 'Non-Aktif' %>
              </span>
            </td>
            <td>
              <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-primary"
                  data-bs-toggle="modal" data-bs-target="#editSupplierModal"
                  data-supplier='<%= JSON.stringify(item) %>'>
                  <i class="bi bi-pencil"></i>
                </button>
                <form action="/master-supplier/<%= item.vendor_id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus supplier ini?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Supplier Modal -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/master-supplier">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Tambah Supplier</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nama Supplier <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="vendor_name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Tipe <span class="text-danger">*</span></label>
            <select class="form-select" name="vendor_type" required>
              <option value="">Pilih Tipe</option>
              <% [['rekondisi','Rekondisi'],['refurbish','Refurbish'],['write_off','Write-Off'],['general','General']].forEach(([val,lbl]) => { %>
                <option value="<%= val %>"><%= lbl %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Contact Person</label>
            <input type="text" class="form-control" name="contact_person">
          </div>
          <div class="mb-3">
            <label class="form-label">Telepon</label>
            <input type="text" class="form-control" name="phone">
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email">
          </div>
          <div class="mb-3">
            <label class="form-label">Alamat</label>
            <textarea class="form-control" name="address" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Simpan</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Supplier Modal -->
<div class="modal fade" id="editSupplierModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editSupplierForm" method="POST" action="">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Supplier</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="editSupplierBody"></div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Update</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('editSupplierModal').addEventListener('show.bs.modal', function(e) {
  const s = JSON.parse(e.relatedTarget.dataset.supplier);
  document.getElementById('editSupplierForm').action = '/master-supplier/' + s.vendor_id + '?_method=PUT';

  const typeOpts = ['rekondisi','refurbish','write_off','general']
    .map(t => `<option value="${t}" ${s.vendor_type===t?'selected':''}>${t.replace('_',' ').toUpperCase()}</option>`).join('');

  document.getElementById('editSupplierBody').innerHTML = `
    <div class="mb-3"><label class="form-label">Nama Supplier *</label>
      <input type="text" class="form-control" name="vendor_name" value="${s.vendor_name||''}" required></div>
    <div class="mb-3"><label class="form-label">Tipe *</label>
      <select class="form-select" name="vendor_type" required><option value="">Pilih</option>${typeOpts}</select></div>
    <div class="mb-3"><label class="form-label">Contact Person</label>
      <input type="text" class="form-control" name="contact_person" value="${s.contact_person||''}"></div>
    <div class="mb-3"><label class="form-label">Telepon</label>
      <input type="text" class="form-control" name="phone" value="${s.phone||''}"></div>
    <div class="mb-3"><label class="form-label">Email</label>
      <input type="email" class="form-control" name="email" value="${s.email||''}"></div>
    <div class="mb-3"><label class="form-label">Alamat</label>
      <textarea class="form-control" name="address" rows="2">${s.address||''}</textarea></div>
    <div class="mb-3"><label class="form-label">Status Supplier</label>
      <select class="form-select" name="is_active">
        <option value="1" ${s.is_active ? 'selected' : ''}>Aktif</option>
        <option value="0" ${!s.is_active ? 'selected' : ''}>Non-Aktif</option>
      </select></div>
  `;
});
</script>
