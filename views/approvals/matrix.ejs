<div class="container-fluid mt-5 pt-4">
  <div class="row mb-3">
    <div class="col">
      <h2><i class="bi bi-diagram-3"></i> Approval Matrix</h2>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
          <li class="breadcrumb-item active">Approval Matrix</li>
        </ol>
      </nav>
    </div>
    <% if (hasRole('admin')) { %>
    <div class="col-auto">
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addRuleModal">
        <i class="bi bi-plus-circle"></i> Add Rule
      </button>
    </div>
    <% } %>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover datatable mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th><th>Rule Name</th><th>Category</th><th>Min Value</th>
            <th>Max Value</th><th>Required Role</th><th>Level</th><th>Status</th>
            <% if (hasRole('admin')) { %><th>Actions</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (!rules.length) { %>
            <tr><td colspan="9" class="text-center text-muted py-4">No approval rules defined</td></tr>
          <% } %>
          <% rules.forEach((rule, i) => { %>
          <tr>
            <td><%= i+1 %></td>
            <td><strong><%= rule.rule_name %></strong></td>
            <td class="text-capitalize"><%= rule.return_category ? rule.return_category.replace('_',' ') : 'All' %></td>
            <td><%- formatCurrency(rule.min_value) %></td>
            <td><%= rule.max_value ? formatCurrency(rule.max_value) : 'Unlimited' %></td>
            <td class="text-capitalize"><%= rule.required_role %></td>
            <td><span class="badge bg-primary">Level <%= rule.approval_level %></span></td>
            <td>
              <span class="badge bg-<%= rule.is_active ? 'success' : 'secondary' %>">
                <%= rule.is_active ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <% if (hasRole('admin')) { %>
            <td>
              <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#editRuleModal"
                  data-id="<%= rule.approval_id %>"
                  data-name="<%= rule.rule_name %>"
                  data-category="<%= rule.return_category || '' %>"
                  data-min="<%= rule.min_value %>"
                  data-max="<%= rule.max_value || '' %>"
                  data-role="<%= rule.required_role %>"
                  data-level="<%= rule.approval_level %>"
                  data-active="<%= rule.is_active %>">
                  <i class="bi bi-pencil"></i>
                </button>
                <form method="POST" action="/approvals/matrix/<%= rule.approval_id %>/delete" class="d-inline">
                  <button type="submit" class="btn btn-outline-danger confirm-delete" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (hasRole('admin')) { %>
<!-- Add Rule Modal -->
<div class="modal fade" id="addRuleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/approvals/matrix/create">
        <div class="modal-header"><h5 class="modal-title">Add Approval Rule</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Rule Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="rule_name" required>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select class="form-select" name="return_category">
                <option value="">All Categories</option>
                <% 
                  const categories = [
                    ['baik', 'Baik'],
                    ['kurang_part', 'Kurang Part'],
                    ['packaging_rusak', 'Packaging Rusak'],
                    ['pecah', 'Pecah']
                  ];
                  categories.forEach(([v, l]) => { 
                %>
                  <option value="<%= v %>"><%= l %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Required Role</label>
              <select class="form-select" name="required_role" required>
                <% ['inspector','manager','admin'].forEach(r => { %>
                  <option value="<%= r %>" class="text-capitalize"><%= r %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Min Value</label>
              <input type="number" class="form-control" name="min_value" value="0" min="0">
            </div>
            <div class="col-md-6">
              <label class="form-label">Max Value (blank = unlimited)</label>
              <input type="number" class="form-control" name="max_value" min="0" placeholder="Unlimited">
            </div>
            <div class="col-md-6">
              <label class="form-label">Approval Level</label>
              <input type="number" class="form-control" name="approval_level" value="1" min="1" max="5">
            </div>
            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select class="form-select" name="is_active">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Rule</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Rule Modal -->
<div class="modal fade" id="editRuleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="editRuleForm">
        <div class="modal-header"><h5 class="modal-title">Edit Approval Rule</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Rule Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="rule_name" id="editRuleName" required>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select class="form-select" name="return_category" id="editRuleCategory">
                <option value="">All Categories</option>
                <% 
                  const editCategories = [
                    ['baik', 'Baik'],
                    ['kurang_part', 'Kurang Part'],
                    ['packaging_rusak', 'Packaging Rusak'],
                    ['pecah', 'Pecah']
                  ];
                  editCategories.forEach(([v, l]) => { 
                %>
                  <option value="<%= v %>"><%= l %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Required Role</label>
              <select class="form-select" name="required_role" id="editRuleRole" required>
                <% ['inspector','manager','admin'].forEach(r => { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Min Value</label>
              <input type="number" class="form-control" name="min_value" id="editRuleMin">
            </div>
            <div class="col-md-6">
              <label class="form-label">Max Value</label>
              <input type="number" class="form-control" name="max_value" id="editRuleMax" placeholder="Unlimited">
            </div>
            <div class="col-md-6">
              <label class="form-label">Level</label>
              <input type="number" class="form-control" name="approval_level" id="editRuleLevel">
            </div>
            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select class="form-select" name="is_active" id="editRuleActive">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('editRuleModal').addEventListener('show.bs.modal', function(e) {
  const btn = e.relatedTarget;
  document.getElementById('editRuleForm').action = '/approvals/matrix/' + btn.dataset.id + '/update';
  document.getElementById('editRuleName').value    = btn.dataset.name;
  document.getElementById('editRuleCategory').value = btn.dataset.category;
  document.getElementById('editRuleRole').value    = btn.dataset.role;
  document.getElementById('editRuleMin').value     = btn.dataset.min;
  document.getElementById('editRuleMax').value     = btn.dataset.max;
  document.getElementById('editRuleLevel').value   = btn.dataset.level;
  document.getElementById('editRuleActive').value  = btn.dataset.active;
});
</script>
<% } %>
