<div class="container-fluid mt-5 pt-4">
  <div class="row mb-4 align-items-center">
    <div class="col-12">
      <h2><i class="bi bi-speedometer2"></i>
        <%= __('Dashboard') %>
      </h2>
      <p class="text-muted mb-0">
        <%= __('Welcome') %>, <strong>
            <%= user.fullName %>
          </strong>
          <span class="badge bg-secondary ms-1">
            <%=
              user.role.replace(/_/g,' ') %></span>
      </p>
    </div>
  </div>

  <%# ── Period Filters ─────────────────────────────────────────────────────────── %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded">
      <form method="GET" action="/dashboard" class="row g-3 align-items-end">
        <div class="col-md-4 col-sm-6">
            <label for="month" class="form-label fw-bold text-secondary small"><i class="bi bi-calendar-event me-1"></i><%= __('Month') %></label>
              <select id="month" name="month" class="form-select bg-white border-secondary-subtle">
                <option value="">
                  <%= __('All Months') %>
                </option>
                <% monthsList.forEach(m=> { %>
                  <option value="<%= m.value %>" <%=selectedMonth===m.value ? 'selected' : '' %>><%= m.name %>
                  </option>
                  <% }) %>
              </select>
    </div>
    <div class="col-md-4 col-sm-6">
      <label for="year" class="form-label fw-bold text-secondary small"><i class="bi bi-calendar3 me-1"></i>
        <%= __('Year') %>
      </label>
      <select id="year" name="year" class="form-select bg-white border-secondary-subtle">
        <option value="">
          <%= __('All Years') %>
        </option>
        <% availableYears.forEach(y=> { %>
          <option value="<%= y %>" <%=selectedYear===y ? 'selected' : '' %>><%= y %>
          </option>
          <% }) %>
      </select>
    </div>
    <div class="col-md-4 col-sm-12 d-flex gap-2">
      <button type="submit" class="btn btn-primary px-4 w-100 fw-bold">
        <i class="bi bi-funnel-fill me-1"></i>
        <%= __('Filter') %>
      </button>
      <a href="/dashboard" class="btn btn-outline-secondary px-4 w-100 fw-bold">
        <i class="bi bi-arrow-counterclockwise me-1"></i>
        <%= __('Reset') %>
      </a>
    </div>
    </form>
  </div>
</div>



      <%# ── Role-Specific Quick Actions ──────────────────────────────────────────── %>
        <% if (hasRole('admin_sorting')) { %>
          <div class="alert alert-info mb-4">
            <i class="bi bi-upc-scan"></i> <strong>Antrian Sorting:</strong>
            <strong class="ms-1">
              <%= roleStats.sortingQueue || 0 %>
            </strong> return menunggu proses sorting.
            <a href="/sorting" class="btn btn-sm btn-info ms-3">Buka Antrian <i class="bi bi-arrow-right"></i></a>
          </div>
          <% } %>
            <% if (hasRole('admin_retur')) { %>
              <div class="alert alert-warning mb-4">
                <i class="bi bi-box-arrow-in-down"></i> <strong>Inbound Queue:</strong>
                <strong class="ms-1">
                  <%= roleStats.inboundQueue || 0 %>
                </strong> return menunggu konfirmasi inbound.
                <a href="/returns/pending" class="btn btn-sm btn-warning ms-3">Lihat Inbound <i
                    class="bi bi-arrow-right"></i></a>
              </div>
              <% } %>
                <% if (hasRole('staff_recover')) { %>
                  <div class="alert alert-success mb-4">
                    <i class="bi bi-recycle"></i> <strong>Recovery Queue:</strong>
                    <strong class="ms-1">
                      <%= roleStats.recoveryQueue || 0 %>
                    </strong> return dalam proses recovery.
                    <a href="/recovery" class="btn btn-sm btn-success ms-3">Buka Recovery <i
                        class="bi bi-arrow-right"></i></a>
                  </div>
                  <% } %>
                    <% if (hasRole(['purchasing','manager'])) { %>
                      <div class="alert alert-primary mb-4">
                        <i class="bi bi-patch-check"></i> <strong>Pengajuan Harga Menunggu:</strong>
                        <strong class="ms-1">
                          <%= roleStats.pendingPricing || 0 %>
                        </strong> pengajuan menunggu approval FAT.
                        <a href="/recovery/fat-approvals" class="btn btn-sm btn-primary ms-3">Approve Harga <i
                            class="bi bi-arrow-right"></i></a>
                      </div>
                      <% } %>

                        <!-- Dashboard Selector Tabs -->
                        <ul class="nav nav-pills mb-4" id="dashboardTabs" role="tablist">
                          <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold" id="return-tab" data-bs-toggle="tab"
                              data-bs-target="#return-tab-pane" type="button" role="tab" aria-controls="return-tab-pane"
                              aria-selected="true">
                              <i class="bi bi-box-seam me-1"></i>
                              <%= __('Dashboard Return') %>
                            </button>
                          </li>
                          <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold" id="ba-tab" data-bs-toggle="tab"
                              data-bs-target="#ba-tab-pane" type="button" role="tab" aria-controls="ba-tab-pane"
                              aria-selected="false">
                              <i class="bi bi-file-earmark-text me-1"></i>
                              <%= __('Dashboard Berita Acara') %>
                            </button>
                          </li>
                        </ul>

                        <div class="tab-content" id="dashboardTabsContent">
                          <!-- Panel 1: Return Dashboard -->
                          <div class="tab-pane fade show active" id="return-tab-pane" role="tabpanel"
                            aria-labelledby="return-tab">
                            <!-- Stats Cards -->
                            <div class="row g-3 mb-4">
                              <div class="col-md-4">
                                <div class="card border-primary shadow-sm h-100">
                                  <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                      <h6 class="text-muted mb-1">
                                        <%= __('Total Returns') %>
                                      </h6>
                                      <h2 class="mb-0 fw-bold">
                                        <%= stats.total_returns %>
                                      </h2>
                                    </div>
                                    <i class="bi bi-box-seam text-primary" style="font-size:2.5rem"></i>
                                  </div>
                                </div>
                              </div>
                              <div class="col-md-4">
                                <div class="card border-warning shadow-sm h-100">
                                  <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                      <h6 class="text-muted mb-1">
                                        <%= __('Inbound') %>
                                      </h6>
                                      <h2 class="mb-0 fw-bold">
                                        <%= stats.pending_returns %>
                                      </h2>
                                    </div>
                                    <i class="bi bi-box-arrow-in-down text-warning" style="font-size:2.5rem"></i>
                                  </div>
                                </div>
                              </div>
                              <div class="col-md-4">
                                <div class="card border-info shadow-sm h-100">
                                  <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                      <h6 class="text-muted mb-1">
                                        <%= __('Sorting / Processing') %>
                                      </h6>
                                      <h2 class="mb-0 fw-bold">
                                        <%= stats.inspecting_returns %>
                                      </h2>
                                    </div>
                                    <i class="bi bi-sort-down text-info" style="font-size:2.5rem"></i>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <!-- Rekondisi, Refurbish, Retur Supplier Lokal, Write Off Stats -->
                            <div class="row g-3 mb-4">
                              <div class="col-md-3 col-sm-6">
                                <div class="card h-100 border-start border-4 border-primary shadow-sm">
                                  <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                      <span class="text-muted fw-bold text-uppercase small"><i
                                          class="bi bi-arrow-repeat text-primary me-1"></i>Rekondisi</span>
                                      <span class="badge bg-primary">
                                        <%= stats.rekondisi_returns || 0 %> Retur
                                      </span>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                      <h3 class="mb-0 fw-bold">
                                        <%= formatNumberId(dispositionStats.rekondisi_qty) %>
                                      </h3>
                                      <span class="text-muted small">pcs</span>
                                    </div>
                                    <div class="text-muted small border-top pt-2">
                                      Nilai: <strong class="text-dark"><%-
                                          formatCurrency(dispositionStats.rekondisi_val) %></strong>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              <div class="col-md-3 col-sm-6">
                                <div class="card h-100 border-start border-4 border-info shadow-sm">
                                  <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                      <span class="text-muted fw-bold text-uppercase small"><i
                                          class="bi bi-tools text-info me-1"></i>Refurbish</span>
                                      <span class="badge bg-info text-dark">
                                        <%= stats.refurbish_returns || 0 %> Retur
                                      </span>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                      <h3 class="mb-0 fw-bold">
                                        <%= formatNumberId(dispositionStats.refurbish_qty) %>
                                      </h3>
                                      <span class="text-muted small">pcs</span>
                                    </div>
                                    <div class="text-muted small border-top pt-2">
                                      Nilai: <strong class="text-dark"><%-
                                          formatCurrency(dispositionStats.refurbish_val) %></strong>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              <div class="col-md-3 col-sm-6">
                                <div class="card h-100 border-start border-4 border-secondary shadow-sm">
                                  <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                      <span class="text-muted fw-bold text-uppercase small"><i
                                          class="bi bi-truck text-secondary me-1"></i>Retur Supplier Lokal</span>
                                      <span class="badge bg-secondary">
                                        <%= stats.supplier_returns || 0 %> Retur
                                      </span>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                      <h3 class="mb-0 fw-bold">
                                        <%= formatNumberId(dispositionStats.supplier_qty) %>
                                      </h3>
                                      <span class="text-muted small">pcs</span>
                                    </div>
                                    <div class="text-muted small border-top pt-2">
                                      Nilai: <strong class="text-dark"><%- formatCurrency(dispositionStats.supplier_val)
                                          %></strong>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              <div class="col-md-3 col-sm-6">
                                <div class="card h-100 border-start border-4 border-danger shadow-sm">
                                  <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                      <span class="text-muted fw-bold text-uppercase small"><i
                                          class="bi bi-trash3 text-danger me-1"></i>Write Off</span>
                                      <span class="badge bg-danger">
                                        <%= stats.write_off_returns || 0 %> Retur
                                      </span>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                      <h3 class="mb-0 fw-bold">
                                        <%= formatNumberId(dispositionStats.write_off_qty) %>
                                      </h3>
                                      <span class="text-muted small">pcs</span>
                                    </div>
                                    <div class="text-muted small border-top pt-2">
                                      Nilai: <strong class="text-dark"><%-
                                          formatCurrency(dispositionStats.write_off_val) %></strong>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <!-- Trend Row -->
                            <div class="row mb-4">
                              <div class="col-lg-12">
                                <div class="card h-100 shadow-sm">
                                  <div class="card-header bg-dark text-white py-3">
                                    <h6 class="mb-0"><i class="bi bi-graph-up text-white me-1"></i>
                                      <%= __('Monthly Inbound vs Outbound Trend (Last 6 Months)') %>
                                    </h6>
                                  </div>
                                  <div class="card-body" style="height: 320px; position: relative;">
                                    <canvas id="movementTrendChart"></canvas>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <!-- Recent Returns -->
                            <div class="card shadow-sm mb-4">
                              <div
                                class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                                <h6 class="mb-0"><i class="bi bi-clock-history text-white me-1"></i>
                                  <%= __('Recent Returns') %>
                                </h6>
                                <a href="/returns" class="btn btn-sm btn-outline-light">View All</a>
                              </div>
                              <div class="card-body p-0">
                                <div class="table-responsive">
                                  <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                      <tr>
                                        <th class="ps-3">No Resi</th>
                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>SLA</th>
                                        <!-- <th>Value</th> -->
                                        <th class="pe-3"></th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% if (recentReturns.length===0) { %>
                                        <tr>
                                          <td colspan="8" class="text-center text-muted py-4">No returns found</td>
                                        </tr>
                                        <% } %>
                                          <% recentReturns.forEach(r=> { %>
                                            <tr>
                                              <td class="ps-3">
                                                <% if (r.resi_number) { %>
                                                  <small class="text-muted"><i class="bi bi-truck me-1"></i>
                                                    <%= r.resi_number %>
                                                  </small>
                                                  <% } else { %>
                                                    <span class="text-muted">-</span>
                                                    <% } %>
                                              </td>
                                              <td>
                                                <%= formatDate(r.return_date) %>
                                              </td>
                                              <td>
                                                <%= r.customer_name || '-' %>
                                              </td>
                                              <td class="text-capitalize">
                                                <%= formatCategory(r.return_category) %>
                                              </td>

                                              <td><%- getStatusBadge(r.current_status) %></td>
                                              <td>
                                                <% if (r.sla_deadline) { %>
                                                  <% const dLeft=Math.round((new Date(r.sla_deadline) - new Date()) /
                                                    86400000); %>
                                                    <span
                                                      class="badge bg-<%= dLeft < 0 ? 'danger' : dLeft <= 2 ? 'warning' : 'success' %> text-nowrap">
                                                      <%= dLeft < 0 ? 'Terlambat ' + Math.abs(dLeft) + 'h' : dLeft
                                                        + 'h lagi' %>
                                                    </span>
                                                    <% } else { %>
                                                      <span class="text-muted">-</span>
                                                      <% } %>
                                              </td>
                                              <!-- <td><%- formatCurrency(r.total_value) %></td> -->
                                              <td class="pe-3 text-end"><a href="/returns/<%= r.return_id %>"
                                                  class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                                              </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                            </div>
                          </div>

                          <!-- Panel 2: Berita Acara Dashboard -->
                          <div class="tab-pane fade" id="ba-tab-pane" role="tabpanel" aria-labelledby="ba-tab">
                            <div id="ba-dashboard-panel" class="dashboard-panel">

                              <!-- SECTION 0: RINGKASAN RETUR & PAKET TERKIRIM -->
                              <div class="row g-3 mb-4">
                                <!-- Card 1: TOTAL PAKET TERKIRIM -->
                                <div class="col-lg-3 col-sm-6">
                                  <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header text-white text-center py-2 fw-bold"
                                      style="background-color: #0b2240; font-size: 0.85rem; border-top-left-radius: 8px; border-top-right-radius: 8px; letter-spacing: 0.5px;">
                                      TOTAL PAKET TERKIRIM
                                    </div>
                                    <div
                                      class="card-body bg-white border border-top-0 d-flex align-items-center gap-3 py-4 px-3"
                                      style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                      <div
                                        class="rounded-circle d-flex align-items-center justify-content-center bg-light border"
                                        style="width: 54px; height: 54px; flex-shrink: 0;">
                                        <i class="bi bi-box text-dark fs-3"></i>
                                      </div>
                                      <div>
                                        <h3 class="mb-0 fw-bold text-dark">
                                          <%= formatNumberId(totalSentPackages) %>
                                        </h3>
                                        <small class="text-muted">paket</small>
                                      </div>
                                    </div>
                                  </div>
                                </div>

                                <!-- Card 2: TOTAL RETUR -->
                                <div class="col-lg-3 col-sm-6">
                                  <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header text-white text-center py-2 fw-bold"
                                      style="background-color: #0b2240; font-size: 0.85rem; border-top-left-radius: 8px; border-top-right-radius: 8px; letter-spacing: 0.5px;">
                                      TOTAL RETUR
                                    </div>
                                    <div
                                      class="card-body bg-white border border-top-0 d-flex align-items-center gap-3 py-4 px-3"
                                      style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                      <div
                                        class="rounded-circle d-flex align-items-center justify-content-center bg-light border"
                                        style="width: 54px; height: 54px; flex-shrink: 0;">
                                        <i class="bi bi-arrow-repeat text-dark fs-3"></i>
                                      </div>
                                      <div>
                                        <h3 class="mb-0 fw-bold text-danger">
                                          <%= formatNumberId(totalReturnsInPeriod) %>
                                        </h3>
                                        <small class="text-muted">paket</small>
                                      </div>
                                    </div>
                                  </div>
                                </div>

                                <!-- Card 3: PERSENTASE RETUR -->
                                <div class="col-lg-3 col-sm-6">
                                  <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header text-white text-center py-2 fw-bold"
                                      style="background-color: #0b2240; font-size: 0.85rem; border-top-left-radius: 8px; border-top-right-radius: 8px; letter-spacing: 0.5px;">
                                      PERSENTASE RETUR
                                    </div>
                                    <div
                                      class="card-body bg-white border border-top-0 d-flex align-items-center gap-3 py-4 px-3"
                                      style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                      <div
                                        class="rounded-circle d-flex align-items-center justify-content-center bg-light border"
                                        style="width: 54px; height: 54px; flex-shrink: 0;">
                                        <i class="bi bi-percent text-dark fs-3"></i>
                                      </div>
                                      <div>
                                        <h3 class="mb-0 fw-bold text-success">
                                          <%= formatPercentageId(returnPercentage) %>
                                        </h3>
                                        <small class="text-muted">dari total paket terkirim</small>
                                      </div>
                                    </div>
                                  </div>
                                </div>

                                <!-- Card 4: RINGKASAN RETUR PERIODIC -->
                                <div class="col-lg-3 col-sm-6">
                                  <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header text-white text-center py-2 fw-bold"
                                      style="background-color: #0b2240; font-size: 0.85rem; border-top-left-radius: 8px; border-top-right-radius: 8px; letter-spacing: 0.5px;">
                                      RINGKASAN RETUR <%= periodName.toUpperCase() %>
                                    </div>
                                    <div
                                      class="card-body bg-white border border-top-0 py-3 px-3 d-flex flex-column justify-content-center"
                                      style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; font-size: 0.9rem; min-height: 102px;">
                                      <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Total Paket Terkirim</span>
                                        <strong class="text-dark">
                                          <%= formatNumberId(totalSentPackages) %> paket
                                        </strong>
                                      </div>
                                      <div class="d-flex justify-content-between mb-2">
                                        <span class="text-secondary">Total Retur</span>
                                        <strong class="text-dark">
                                          <%= formatNumberId(totalReturnsInPeriod) %> paket
                                        </strong>
                                      </div>
                                      <hr class="my-1 text-muted">
                                      <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="text-secondary">Persentase Retur</span>
                                        <strong class="text-success fs-5">
                                          <%= formatPercentageId(returnPercentage) %>
                                        </strong>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              <!-- BA Summary Total Banner (PCS and Percentage) -->
                              <div class="card mb-4 border-0 shadow-sm text-white"
                                style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                                <div class="card-body py-4">
                                  <div class="row align-items-center">
                                    <div class="col-lg-8">

                                      <div class="row g-3">
                                        <% baSummary.forEach(item=> {
                                          const labelMap = {
                                          rekondisi: { name: 'Rekondisi', color: 'primary', bgClass: 'bg-primary', icon:
                                          'bi-arrow-repeat' },
                                          refurbish: { name: 'Refurbish', color: 'dark', bgClass: 'bg-info', icon:
                                          'bi-tools'
                                          },
                                          write_off: { name: 'Write Off', color: 'danger', bgClass: 'bg-danger', icon:
                                          'bi-trash' },
                                          return_to_supplier: { name: 'Supplier Lokal', color: 'secondary', bgClass:
                                          'bg-secondary', icon: 'bi-building' }
                                          };
                                          const meta = labelMap[item.status] || { name: item.status.toUpperCase(),
                                          color:
                                          'secondary', bgClass: 'bg-secondary', icon: 'bi-question-circle' };
                                          %>
                                          <div class="col-md-3 col-6">
                                            <div
                                              class="p-3 rounded bg-white bg-opacity-10 border border-white border-opacity-10 h-100 d-flex flex-column justify-content-between">
                                              <div>
                                                <span class="text-white-50 d-block small mb-2 fw-bold">
                                                  <i class="bi <%= meta.icon %> me-1 text-info"></i>
                                                  <%= meta.name %>
                                                </span>
                                                <div class="d-flex align-items-baseline gap-2">
                                                  <h3 class="mb-0 fw-bold">
                                                    <%= item.qty %>
                                                  </h3>
                                                  <span class="text-info small fw-semibold">
                                                    <%= item.pct %>%
                                                  </span>
                                                </div>
                                              </div>
                                              <div class="progress mt-3"
                                                style="height: 4px; background-color: rgba(255,255,255,0.1);">
                                                <div class="progress-bar <%= meta.bgClass %>" role="progressbar"
                                                  style="width: <%= item.pct %>%"></div>
                                              </div>
                                            </div>
                                          </div>
                                          <% }) %>
                                      </div>
                                    </div>
                                    <div class="col-lg-4 text-center mt-3 mt-lg-0">
                                      <% const totalPcsVal=baSummary.reduce((sum, row)=> sum + parseInt(row.qty || 0),
                                        0);
                                        %>
                                        <div style="width: 150px; height: 150px; position: relative;" class="mx-auto">
                                          <canvas id="baSummaryDoughnut"
                                            style="max-height: 150px; max-width: 150px; z-index: 2; position: relative;"></canvas>
                                          <div
                                            style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 1;">
                                            <span class="d-block text-white-50 font-monospace"
                                              style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Total</span>
                                            <strong class="d-block text-white fw-bold"
                                              style="font-size: 1.25rem; line-height: 1.2;">
