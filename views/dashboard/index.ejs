                        <!-- Hidden Data Elements for Charts -->
                        <div id="ba-summary-data" data-json="<%= JSON.stringify(baSummary) %>" class="d-none"></div>
                        <div id="rekondisi-data" data-json="<%= JSON.stringify(rekondisiData) %>" class="d-none"></div>
                        <div id="refurbish-data" data-json="<%= JSON.stringify(refurbishData) %>" class="d-none"></div>
                        <div id="write-off-data" data-json="<%= JSON.stringify(writeOffData) %>" class="d-none"></div>
                        <div id="supplier-lokal-data" data-json="<%= JSON.stringify(supplierLokalData) %>"
                          class="d-none"></div>

                        <div id="status-data" data-json="<%= JSON.stringify(statusData) %>" class="d-none"></div>
                        <div id="aging-data" data-json="<%= JSON.stringify(aging) %>" class="d-none"></div>
                        <div id="inbound-trend-data" data-json="<%= JSON.stringify(inboundTrend) %>" class="d-none">
                        </div>
                        <div id="outbound-trend-data" data-json="<%= JSON.stringify(outboundTrend) %>" class="d-none">
                        </div>

                        <script>
                          document.addEventListener('DOMContentLoaded', function () {
                            // Chart instances holder
                            const chartInstances = {};

                            // --- Load Berita Acara Data ---
                            const baSummary = JSON.parse(document.getElementById('ba-summary-data').dataset.json);
                            window.rekondisiData = JSON.parse(document.getElementById('rekondisi-data').dataset.json);
                            window.refurbishData = JSON.parse(document.getElementById('refurbish-data').dataset.json);
                            window.writeOffData = JSON.parse(document.getElementById('write-off-data').dataset.json);
                            window.supplierLokalData = JSON.parse(document.getElementById('supplier-lokal-data').dataset.json);

                            // --- Load Return Dashboard Data ---
                            const statusData = JSON.parse(document.getElementById('status-data').dataset.json);
                            const agingData = JSON.parse(document.getElementById('aging-data').dataset.json);
                            const inboundTrend = JSON.parse(document.getElementById('inbound-trend-data').dataset.json);
                            const outboundTrend = JSON.parse(document.getElementById('outbound-trend-data').dataset.json);

                            // --- Berita Acara Summary Doughnut Chart ---
                            if (baSummary && baSummary.length) {
                              const summaryLabels = {
                                rekondisi: 'Rekondisi',
                                refurbish: 'Refurbish',
                                write_off: 'Write Off',
                                return_to_supplier: 'Supplier Lokal'
                              };
                              const summaryColors = {
                                rekondisi: '#0d6efd',
                                refurbish: '#0dcaf0',
                                write_off: '#dc3545',
                                return_to_supplier: '#6c757d'
                              };

                              chartInstances.baSummaryDoughnut = new Chart(document.getElementById('baSummaryDoughnut'), {
                                type: 'doughnut',
                                data: {
                                  labels: baSummary.map(d => summaryLabels[d.status] || d.status),
                                  datasets: [{
                                    data: baSummary.map(d => d.qty),
                                    backgroundColor: baSummary.map(d => summaryColors[d.status] || '#6c757d'),
                                    borderWidth: 0,
                                    cutout: '78%',
                                    spacing: 4,
                                    borderRadius: 4
                                  }]
                                },
                                options: {
                                  responsive: true,
                                  maintainAspectRatio: false,
                                  plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                      callbacks: {
                                        label: function (context) {
                                          let label = context.label || '';
                                          let val = context.parsed || 0;
                                          let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                          let pct = total ? ((val / total) * 100).toFixed(1) : 0;
                                          return `${label}: ${val} pcs (${pct}%)`;
                                        }
                                      }
                                    }
                                  }
                                }
                              });
                            }

                            // --- Top 3 Rekondisi Chart (Vertical Bar Chart) ---
                            if (window.rekondisiData && window.rekondisiData.top3 && window.rekondisiData.top3.length) {
                              chartInstances.rekondisiTop3Chart = new Chart(document.getElementById('rekondisiTop3Chart'), {
                                type: 'bar',
                                data: {
                                  labels: window.rekondisiData.top3.map(d => d.sku),
                                  datasets: [{
                                    data: window.rekondisiData.top3.map(d => d.qty),
                                    backgroundColor: '#0d6efd',
                                    borderRadius: 4,
                                    barThickness: 24
                                  }]
                                },
                                options: {
                                  responsive: true,
                                  maintainAspectRatio: false,
                                  plugins: { legend: { display: false } },
                                  scales: {
                                    x: { grid: { display: false } },
                                    y: { beginAtZero: true, grid: { display: false }, ticks: { stepSize: 1 } }
                                  }
                                }
                              });
                            }

                            // --- Top 3 Refurbish Chart (Vertical Bar Chart) ---
                            if (window.refurbishData && window.refurbishData.top3 && window.refurbishData.top3.length) {
                              chartInstances.refurbishTop3Chart = new Chart(document.getElementById('refurbishTop3Chart'), {
                                type: 'bar',
                                data: {
                                  labels: window.refurbishData.top3.map(d => d.sku),
                                  datasets: [{
                                    data: window.refurbishData.top3.map(d => d.qty),
                                    backgroundColor: '#0dcaf0',
                                    borderRadius: 4,
                                    barThickness: 24
                                  }]
                                },
                                options: {
                                  responsive: true,
                                  maintainAspectRatio: false,
                                  plugins: { legend: { display: false } },
                                  scales: {
                                    x: { grid: { display: false } },
                                    y: { beginAtZero: true, grid: { display: false }, ticks: { stepSize: 1 } }
                                  }
                                }
                              });
                            }

                            // --- Top 3 Write Off Chart (Vertical Bar Chart) ---
                            if (window.writeOffData && window.writeOffData.top3 && window.writeOffData.top3.length) {
                              chartInstances.writeOffTop3Chart = new Chart(document.getElementById('writeOffTop3Chart'), {
                                type: 'bar',
                                data: {
                                  labels: window.writeOffData.top3.map(d => d.sku),
                                  datasets: [{
                                    data: window.writeOffData.top3.map(d => d.qty),
                                    backgroundColor: '#dc3545',
                                    borderRadius: 4,
                                    barThickness: 24
                                  }]
                                },
                                options: {
                                  responsive: true,
                                  maintainAspectRatio: false,
                                  plugins: { legend: { display: false } },
                                  scales: {
                                    x: { grid: { display: false } },
                                    y: { beginAtZero: true, grid: { display: false }, ticks: { stepSize: 1 } }
                                  }
                                }
                              });
                            }

                            // --- Top 3 Supplier Lokal Chart (Vertical Bar Chart) ---
                            if (window.supplierLokalData && window.supplierLokalData.top3 && window.supplierLokalData.top3.length) {
                              chartInstances.supplierLokalTop3Chart = new Chart(document.getElementById('supplierLokalTop3Chart'), {
                                type: 'bar',
                                data: {
                                  labels: window.supplierLokalData.top3.map(d => d.sku),
                                  datasets: [{
                                    data: window.supplierLokalData.top3.map(d => d.qty),
                                    backgroundColor: '#6c757d',
                                    borderRadius: 4,
                                    barThickness: 24
                                  }]
                                },
                                options: {
                                  responsive: true,
                                  maintainAspectRatio: false,
                                  plugins: { legend: { display: false } },
                                  scales: {
                                    x: { grid: { display: false } },
                                    y: { beginAtZero: true, grid: { display: false }, ticks: { stepSize: 1 } }
                                  }
                                }
                              });
                            }

                            // Status Chart and Aging Chart initialization removed.

                            // --- Return Dashboard Movement Trend Chart ---
                            const allMonths = Array.from(new Set([
                              ...inboundTrend.map(d => d.month),
                              ...outboundTrend.map(d => d.month)
                            ])).sort();

                            const inboundDataMap = {};
                            inboundTrend.forEach(d => { inboundDataMap[d.month] = d.count; });

                            const outboundDataMap = {};
                            outboundTrend.forEach(d => { outboundDataMap[d.month] = d.count; });

                            const chartLabels = allMonths.map(m => {
                              const [year, month] = m.split('-');
                              const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
                              return `${months[parseInt(month) - 1]} ${year}`;
                            });

                            const inboundCounts = allMonths.map(m => inboundDataMap[m] || 0);
                            const outboundCounts = allMonths.map(m => outboundDataMap[m] || 0);

                            if (allMonths.length) {
                              chartInstances.movementTrendChart = new Chart(document.getElementById('movementTrendChart'), {
                                type: 'bar',
                                data: {
                                  labels: chartLabels,
                                  datasets: [
                                    {
                                      label: 'Inbound (Masuk)',
                                      data: inboundCounts,
                                      backgroundColor: '#ffc107',
                                      borderColor: '#ffc107',
                                      borderWidth: 1
                                    },
                                    {
                                      label: 'Outbound (Keluar)',
                                      data: outboundCounts,
                                      backgroundColor: '#198754',
                                      borderColor: '#198754',
                                      borderWidth: 1
                                    }
                                  ]
                                },
                                options: {
                                  responsive: true,
                                  plugins: {
                                    legend: { position: 'top' }
                                  },
                                  scales: {
                                    y: {
                                      beginAtZero: true,
                                      ticks: { stepSize: 1 }
                                    }
                                  }
                                }
                              });
                            }

                            // --- Handle tab shown event to resize charts properly ---
                            document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(tabEl => {
                              tabEl.addEventListener('shown.bs.tab', () => {
                                Object.values(chartInstances).forEach(chart => {
                                  if (chart) chart.resize();
                                });
                              });
                            });
                          });


                        </script>